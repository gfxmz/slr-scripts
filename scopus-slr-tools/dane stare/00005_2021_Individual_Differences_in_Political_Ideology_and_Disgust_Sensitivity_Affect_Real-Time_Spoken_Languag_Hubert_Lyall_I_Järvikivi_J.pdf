:467},"Journal",[417],{"id":418,"src":419,"name":420,"type":421,"width":422,"height":423,"idHash":424,"archive":425,"brandId":426,"limited":425,"fileSize":427,"isPublic":428,"original":429,"copyright":19,"extension":430,"thumbnails":432,"dateCreated":440,"description":19,"orientation":441,"userCreated":442,"watermarked":425,"dateModified":440,"datePublished":443,"ecsArchiveFiles":444,"propertyOptions":445,"property_Channel":450,"property_Sub-Type":452,"property_Asset_Type":454,"activeOriginalFocusPoint":456,"property_Office_Department":459},"0F39389F-DE2D-4BF1-AFE71BA9B6F25024","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/0F39389F-DE2D-4BF1-AFE71BA9B6F25024/webimage-58DE3D89-E16A-4C93-B1B7ACD8DCE23BE3.jpg","FPSYG_Main Visual_Green_Website","image",4182,2788,"770e499acb424273",0,"22C10171-81B3-4DA6-99342F272A32E8BB",3018237,1,"https://brand.frontiersin.org/m/770e499acb424273/original/FPSYG_Main-Visual_Green_Website.jpeg",[431],"jpeg",{"mini":433,"thul":434,"webimage":419,"Guidelines":435,"WebsiteJpg_XL":436,"WebsiteWebP_L":437,"WebsiteWebP_M":438,"WebsiteWebP_XL":439},"https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/0F39389F-DE2D-4BF1-AFE71BA9B6F25024/mini-17A2BFEC-6D07-48BE-8DEA39EE0335A9CA.jpg","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/0F39389F-DE2D-4BF1-AFE71BA9B6F25024/thul-CD131BC9-F1DD-4DB0-B4E9F2CD8093E96C.jpg","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/0F39389F-DE2D-4BF1-AFE71BA9B6F25024/918D96DB-F484-4EC1-8FBF9AB5F74B20F4/Guidelines-FPSYG_Main Visual_Green_Website.png","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/0F39389F-DE2D-4BF1-AFE71BA9B6F25024/918D96DB-F484-4EC1-8FBF9AB5F74B20F4/WebsiteJpg_XL-FPSYG_Main Visual_Green_Website.jpg","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/0F39389F-DE2D-4BF1-AFE71BA9B6F25024/918D96DB-F484-4EC1-8FBF9AB5F74B20F4/WebsiteWebP_L-FPSYG_Main Visual_Green_Website.webp","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/0F39389F-DE2D-4BF1-AFE71BA9B6F25024/918D96DB-F484-4EC1-8FBF9AB5F74B20F4/WebsiteWebP_M-FPSYG_Main Visual_Green_Website.webp","https://d2csxpduxe849s.cloudfront.net/media/E32629C6-9347-4F84-81FEAEF7BFA342B3/0F39389F-DE2D-4BF1-AFE71BA9B6F25024/918D96DB-F484-4EC1-8FBF9AB5F74B20F4/WebsiteWebP_XL-FPSYG_Main Visual_Green_Website.webp","2022-06-27T10:00:51Z","landscape","Caroline Sutter","2022-06-27T06:08:54Z",[],[446,447,448,449],"414FB2D4-2283-43FD-BE14E534ECA67928","6C18119B-14BD-4951-B437696F4357BD33","7C692885-DB25-4858-B1FB4FF47B241E9B","D88C0047-EC30-4506-A7DF28A4D765E1CF",[451],"frontiersin_org",[453],"Main_Visual",[455],"Photography",{"x":457,"y":458},2091,1394,[460],"Publishing","The world's most cited psychology journal, covering topics from clinical research to cognitive science, from imaging studies to human factors, and from animal cognition to social psychology.","\u003Cp>Frontiers in Psychology is a multidisciplinary journal that publishes advances in psychological research.\u003C/p>\n\u003Cp>Led by Field Chief Editor Prof. Axel Cleeremans (Université Libre de Bruxelles, Belgium) Frontiers in Psychology is included in PubMed Central (PMC), Scopus, Web of Science (SSCI) and the DOAJ among others, and welcomes research contributions across the field. Topics include, but are not limited to:\u003C/p>\n\u003Cdiv> &bull; health and clinical psychology\u003C/div>\n\u003Cdiv> &bull; cognitive science\u003C/div>\n\u003Cdiv> &bull; consciousness research\u003C/div>\n\u003Cdiv> &bull; perception science\u003C/div>\n\u003Cdiv> &bull; personality and social psychology.\u003C/div>\n\u003Cbr>\n\u003Cp>The journal welcomes submissions which support and advance the UN’s Sustainable Development Goals (SDG), notably mental health outlined in SDG3, good health and well-being, its partial focus to address the rise of anxiety and depression, particularly among children and adolescents. The journal had an acceptance rate of 37% in 2024.\u003C/p>\n\u003Cp>Psychology is a highly interdisciplinary science, however, manuscripts that are related to pedagogy, linguistics, business, economics, management, artificial intelligence or environmental impacts without a fundamental psychological basis are not suitable for publication in this title. Research that is purely technological, such as digital technology or neural network analysis, without a foundation in psychology, is also outside the scope of this journal.\u003C/p> \n\u003Cp>After careful discussion with the Field Chief Editor of Frontiers in Psychology, the journal no longer accepts papers concerning simple bibliometric studies. Authors are still welcome to submit Systematic Reviews using publicly available data, but these must adhere to the \u003Ca href=\"https://prisma-statement.org/documents/PRISMA_2020_checklist.pdf\"> PRISMA guidelines\u003C/a> and have a conclusion related to psychology. Studies without any particular relevance to psychological phenomena will be transferred to a more applicable journal.\u003C/p>\n\u003Cp>Frontiers’ journals require that manuscripts primarily comprising computational studies of public data, must include appropriate validation. Please refer to the \u003Ca href=\"https://www.frontiersin.org/guidelines/policies-and-publication-ethics#standards-for-research-methodology:~:text=complaints%20and%20allegations.-,Standards%20for%20research%20methodology,-Experiments\">Frontiers Standards for research methodology policy\u003C/a>, for more information. Manuscripts not adhering to these standards will not be considered.\u003Cp>\n\u003Cp>Frontiers in Psychology is committed to advancing developments in the field by allowing unrestricted access to articles, and communicating scientific knowledge to psychologists, researchers, academics and the public alike, to enable the scientific breakthroughs of the future.\u003C/p>","green","3.8","4.5","1205684","@FrontPsychol",{"id":124,"name":125,"slug":126,"abbreviation":469,"isOnline":13,"isOpenForSubmissions":-1,"impactFactor":470,"citeScore":471},"fpsyg",3.8,7,{"displayTitlePillLabels":13,"displayRelatedArticlesBox":13,"showEditors":13,"showReviewers":13,"showLoopImpactLink":13,"enableFigshare":413},{"isPublic":413,"allowCompanyUsers":413,"whiteListEmails":474,"enableAllJournals":413,"whiteListJournals":475},[],[],{"spaceId":428,"name":428,"availableJournalPages":477,"announcement":481,"useJournalPalettes":413},[320,325,322,478,479,480],"volumes","about","community-reviewers",{"__typename":482,"sys":483,"preHeader":485,"title":486,"description":487,"image":488,"link":563},"Announcement",{"id":484},"30jAeTjZfu9FwrF5jqYs9f","Our quality","Expert judgment makes science stronger","Behind every published article stand expert reviewers safeguarding science. Discover our rigorous approach to peer review.",[489],{"id":490,"src":491,"name":492,"tags":493,"type":421,"width":543,"height":544,"archive":425,"brandId":426,"limited":425,"fileSize":545,"isPublic":428,"original":546,"copyright":28,"extension":547,"thumbnails":549,"dateCreated":557,"description":492,"orientation":441,"watermarked":425,"dateModified":558,"selectedFile":28,"datePublished":559,"streamingLinks":560,"videoPreviewURLs":561,"textMetaproperties":562},"E8101B5E-CD70-402C-B234D8C42CD1D053","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/webimage-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","Doctor making notes in hospital, corona virus concept. Shot through glass.",[494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542],"global","professional","pandemic","conference","contagious","pneumonia","respiratory","medical","glass","exhausted","outbreak","corona","virus","making notes","writing","DOCTOR","contamination","training","Risk","Coronavirus","Science","warning","Hospital","health","close-up","infection","research","safety","prevention","concept","danger","Indoors","Disease","fever","scientist","flu","protection","men","viral","copy space","shot","Clinic","illness","healthcare","cure","seminar","epidemic","treatment","working on",4928,3280,14062390,"https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.jpg",[548],"jpg",{"mini":550,"thul":551,"original":546,"webimage":491,"Guidelines":552,"WebsiteJpg_XL":553,"WebsiteWebP_L":554,"WebsiteWebP_M":555,"WebsiteWebP_XL":556},"https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/mini-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/thumbnail/thul-Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/Guidelines/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.png","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteJpg_XL/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.jpg","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_L/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_M/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","https://brand.frontiersin.org/asset/e8101b5e-cd70-402c-b234-d8c42cd1d053/WebsiteWebP_XL/Doctor-making-notes-in-hospital-corona-virus-concept-Shot-through-glass.webp","2022-05-10T11:52:42Z","2026-02-11T15:34:30Z","2022-05-11T12:46:58Z",{},[],[],{"text":564,"url":67,"target":27,"ariaLabel":28},"Learn about peer review",{"loggedUserInfo":-1},{"currentArticle":567,"isPreviewPage":413,"hasSupplementalData":413,"showCrossmarkWidget":13,"articleTemplate":678,"currentArticlePageMetaInfo":679,"xmlParsedArticleContent":784,"xmlParsingError":-1},{"id":568,"doi":569,"title":570,"acceptanceDate":571,"receptionDate":572,"publicationDate":573,"lastModifiedDate":574,"isPublished":13,"abstract":575,"researchTopic":28,"articleType":576,"stage":579,"keywords":581,"authors":590,"editors":607,"reviewers":617,"journal":636,"section":643,"impactMetrics":645,"volume":649,"articleVolume":650,"relatedArticles":651,"isPublishedV2":413,"contents":652,"laySummary":19,"files":653},699071,"10.3389/fpsyg.2021.699071","Individual Differences in Political Ideology and Disgust Sensitivity Affect Real-Time Spoken Language Comprehension",["Date","2021-09-13T06:58:04.000Z"],["Date","2021-04-22T17:17:25.000Z"],["Date","2021-10-11T00:00:00.000Z"],["Date","2026-09-25T02:33:45.457Z"],"Individuals’ moral views have been shown to affect their event-related potentials (ERP) response to spoken statements, and people’s political ideology has been shown to guide their sentence completion behavior. Using pupillometry, we asked whether political ideology and disgust sensitivity affect online spoken language comprehension. 60 native speakers of English listened to spoken utterances while their pupil size was tracked. Some of those utterances contained grammatical errors, semantic anomalies, or socio-cultural violations, statements incongruent with existing gender stereotypes and perceived speaker identity, such as ``I sometimes buy my bras at Hudson's Bay'', spoken by a male speaker. An individual's disgust sensitivity is associated with the Behavioral Immune System, and may be correlated with socio-political attitudes, for example regarding out-group stigmatization. We found that more disgust-sensitive individuals showed greater pupil dilation with semantic anomalies and socio-cultural violations. However, political views differently affected the processing of the two types of violations: whereas more conservative listeners showed a greater pupil response to socio-cultural violations, more progressive listeners engaged more with semantic anomalies, but this effect appeared much later in the pupil record.",{"id":577,"name":578},139,"Brief Research Report",{"id":580,"name":19},18,[582,583,584,585,586,587,588,589],"Psycholinguistics","spoken language comprehension","Semantic anomalies","Gender stereotypes","political ideology","disgust sensitivity","Speaker identity","Pupillometry",[591,600],{"id":592,"firstName":593,"middleName":19,"lastName":594,"givenNames":595,"isCorresponding":413,"isProfilePublic":13,"userId":592,"email":-1,"affiliations":596},1332444,"Isabell","Hubert Lyall","Isabell ",[597],{"organizationName":598,"countryName":599,"cityName":19,"stateName":19,"zipCode":19},"Department of Linguistics, University of Alberta","Canada",{"id":601,"firstName":602,"middleName":19,"lastName":603,"givenNames":604,"isCorresponding":413,"isProfilePublic":13,"userId":601,"email":-1,"affiliations":605},21387,"Juhani","Järvikivi","Juhani ",[606],{"organizationName":598,"countryName":599,"cityName":19,"stateName":19,"zipCode":19},[608],{"id":609,"firstName":610,"middleName":19,"lastName":611,"givenNames":612,"isCorresponding":413,"isProfilePublic":13,"userId":609,"email":-1,"affiliations":613},1300614,"Tim","Wharton","Tim ",[614],{"organizationName":615,"countryName":616,"cityName":19,"stateName":19,"zipCode":19},"University of Brighton","United Kingdom",[618,627],{"id":619,"firstName":620,"middleName":19,"lastName":621,"givenNames":622,"isCorresponding":413,"isProfilePublic":13,"userId":619,"email":-1,"affiliations":623},449605,"Serhii","Zasiekin","Serhii ",[624],{"organizationName":625,"countryName":626,"cityName":19,"stateName":19,"zipCode":19},"Lesya Ukrainka Volyn National University","Ukraine",{"id":628,"firstName":629,"middleName":19,"lastName":630,"givenNames":631,"isCorresponding":413,"isProfilePublic":13,"userId":628,"email":-1,"affiliations":632},570300,"Quanlei","Yu","Quanlei ",[633],{"organizationName":634,"countryName":635,"cityName":19,"stateName":19,"zipCode":19},"Central China Normal University","China",{"id":124,"slug":126,"name":125,"shortName":637,"electronicISSN":638,"field":639,"specialtyId":28,"journalSectionPaths":641},"Front. Psychol.","1664-1078",{"id":640,"domainId":428},69,[642],{"section":643},{"id":241,"name":242,"slug":243,"specialtyId":644},603,{"views":646,"downloads":647,"citations":648},5465,1431,5,12,"Volume 12 - 2021",[],{"titleHtml":19,"fullTextHtml":19,"menuHtml":19},[654,659,665,668,674],{"name":655,"fileServerPackageEntryId":19,"fileServerId":656,"fileServerVersionNumber":428,"type":657},"EPUB.epub","699071/epub",{"code":658,"name":658},"EPUB",{"name":660,"fileServerPackageEntryId":661,"fileServerId":662,"fileServerVersionNumber":428,"type":663},"fpsyg-12-699071.pdf","fpsyg-12-699071/fpsyg-12-699071.pdf","699071/pubmed-zip",{"code":664,"name":664},"PDF",{"name":660,"fileServerPackageEntryId":19,"fileServerId":666,"fileServerVersionNumber":428,"type":667},"699071/publishers-proof/pdf",{"code":664,"name":664},{"name":669,"fileServerPackageEntryId":670,"fileServerId":662,"fileServerVersionNumber":428,"type":671},"fpsyg-12-699071.xml","fpsyg-12-699071/fpsyg-12-699071.xml",{"code":672,"name":673},"NLM_XML","XML",{"name":675,"fileServerPackageEntryId":19,"fileServerId":676,"fileServerVersionNumber":428,"type":677},"Provisional PDF.pdf","699071/provisional-pdf",{"code":664,"name":664},"v4",{"title":680,"link":681,"meta":685,"script":773},"Frontiers | Individual Differences in Political Ideology and Disgust Sensitivity Affect Real-Time Spoken Language Comprehension",[682],{"rel":683,"href":684},"canonical","https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2021.699071/full",[686,689,692,694,697,701,704,708,711,714,717,719,721,723,725,727,730,733,735,738,740,742,745,748,751,754,757,761,765,768,770],{"hid":687,"property":687,"name":687,"content":688},"description","Individuals’ moral views have been shown to affect their event-related potentials (ERP) response to spoken statements, and people’s political ideology has be...",{"hid":690,"property":690,"name":691,"content":680},"og:title","title",{"hid":693,"property":693,"name":687,"content":688},"og:description",{"hid":695,"name":695,"content":696},"keywords","Psycholinguistics,spoken language comprehension,Semantic anomalies,Gender stereotypes,political ideology,disgust sensitivity,Speaker identity,Pupillometry",{"hid":698,"property":698,"name":699,"content":700},"og:site_name","site_name","Frontiers",{"hid":702,"property":702,"name":421,"content":703},"og:image","https://www.frontiersin.org/api/ipx/w=1200&f=png/https://www.frontiersin.org/files/Articles/699071/fpsyg-12-699071-HTML/image_m/fpsyg-12-699071-g001.jpg",{"hid":705,"property":705,"name":706,"content":707},"og:type","type","article",{"hid":709,"property":709,"name":710,"content":684},"og:url","url",{"hid":712,"name":712,"content":713},"twitter:card","summary_large_image",{"hid":715,"name":715,"content":716},"citation_volume","12",{"hid":718,"name":718,"content":125},"citation_journal_title",{"hid":720,"name":720,"content":700},"citation_publisher",{"hid":722,"name":722,"content":637},"citation_journal_abbrev",{"hid":724,"name":724,"content":638},"citation_issn",{"hid":726,"name":726,"content":569},"citation_doi",{"hid":728,"name":728,"content":729},"citation_firstpage","699071",{"hid":731,"name":731,"content":732},"citation_language","English",{"hid":734,"name":734,"content":570},"citation_title",{"hid":736,"name":736,"content":737},"citation_keywords","Psycholinguistics; spoken language comprehension; Semantic anomalies; Gender stereotypes; political ideology; disgust sensitivity; Speaker identity; Pupillometry",{"hid":739,"name":739,"content":575},"citation_abstract",{"hid":741,"name":741,"content":578},"citation_article_type",{"hid":743,"name":743,"content":744},"citation_pdf_url","https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2021.699071/pdf",{"hid":746,"name":746,"content":747},"citation_xml_url","https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2021.699071/xml",{"hid":749,"name":749,"content":750},"citation_fulltext_world_readable","yes",{"hid":752,"name":752,"content":753},"citation_online_date","2021/09/13",{"hid":755,"name":755,"content":756},"citation_publication_date","2021/10/11",{"hid":758,"name":759,"content":760},"citation_author_0","citation_author","Hubert Lyall, Isabell ",{"hid":762,"name":763,"content":764},"citation_author_institution_0","citation_author_institution","Department of Linguistics, University of Alberta, Canada",{"hid":766,"name":759,"content":767},"citation_author_1","Järvikivi, Juhani ",{"hid":769,"name":763,"content":764},"citation_author_institution_1",{"hid":771,"name":771,"content":772},"dc.identifier","doi:10.3389/fpsyg.2021.699071",[774,777,780,782],{"src":775,"body":13,"type":776,"async":13},"https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=es6","text/javascript",{"innerHTML":778,"type":779},"MathJax.Hub.Config({\"CommonHTML\":{linebreaks:{automatic:true,width:\"container\"}}});","text/x-mathjax-config",{"src":781,"body":13,"type":776,"async":13},"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-MML-AM_CHTML",{"src":783,"body":13,"type":776,"async":13},"https://crossmark-cdn.crossref.org/widget/v2.0/widget.js",{"journal":785,"doi":569,"articleType":578,"title":787,"authors":789,"onBehalfOf":19,"affiliations":796,"authorNotes":800,"publicationDate":834,"acceptedDate":835,"receivedDate":836,"correctedDate":19,"retractedDate":19,"volume":649,"elocationId":568,"permissions":837,"keywords":857,"relatedArticles":879,"abstractContent":880,"bodyContent":888,"appendixContent":3232,"statements":3233,"referenceLists":3320,"references":13363,"otherBackSections":22446,"figures":22447,"toc":22667,"correspondingAuthors":22681},{"title":125,"abbreviation":637,"issn":638,"publisherName":786},"Frontiers Media S.A.",[788],{"#text":570},[790,793],{"surname":594,"givenNames":593,"suffix":19,"affiliationsIndexes":791,"isCorresponding":413,"equalContrib":413,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":792,"onBehalfOf":19},[],"http://loop.frontiersin.org/people/1332444/overview",{"surname":603,"givenNames":602,"suffix":19,"affiliationsIndexes":794,"isCorresponding":13,"equalContrib":413,"hierarchySymbol":19,"footnoteSymbol":19,"loopUrl":795,"onBehalfOf":19},[],"http://loop.frontiersin.org/people/21387/overview",[797],{"index":425,"baseText":19,"institution":598,"country":599,"address":798,"textContent":799},"Edmonton, AB","Department of Linguistics, University of Alberta, Edmonton, AB, Canada",{"editedBy":801,"editedByContent":804,"reviewedBy":813,"reviewedByContent":816,"approvedBy":823,"approvedByContent":824,"correspondence":825,"equalContribution":826,"presentAddress":19,"other":827},[802],{"textContent":803},"Edited by: Tim Wharton, University of Brighton, United Kingdom",[805,807,811],{"#text":806},"\n          ",{"p":808},[809],{"#text":810}," Tim Wharton, University of Brighton, United Kingdom",{"#text":812},"\n        ",[814],{"textContent":815},"Reviewed by: Serhii Zasiekin, Lesya Ukrainka East European National University, Ukraine; Quanlei Yu, Central China Normal University, China",[817,818,822],{"#text":806},{"p":819},[820],{"#text":821}," Serhii Zasiekin, Lesya Ukrainka East European National University, Ukraine; Quanlei Yu, Central China Normal University, China",{"#text":812},[],[],"*Correspondence: Juhani Järvikivi amFydmlraXZpQHVhbGJlcnRhLmNh",[],[828,829,833],{"#text":806},{"p":830},[831],{"#text":832},"This article was submitted to Language Sciences, a section of the journal Frontiers in Psychology",{"#text":812},"2021-10-11","2021-09-07","2021-06-15",{"copyrightStatement":838,"copyrightYear":839,"copyrightHolder":840,"licenseUrl":841,"licenseText":842},"Copyright © 2021 Hubert Lyall and Järvikivi.",2021,"Hubert Lyall and Järvikivi","http://creativecommons.org/licenses/by/4.0/",[843,844,856],{"#text":806},{"p":845},[846,848,854],{"#text":847},"This is an open-access article distributed under the terms of the ",{"ext-link":849,":@":852},[850],{"#text":851},"Creative Commons Attribution License (CC BY)",{"@_ext-link-type":853,"@_xlink:href":841},"uri",{"#text":855},". The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms.",{"#text":812},[858,861,863,866,869,871,873,876],[859],{"#text":860},"psycholinguistics",[862],{"#text":583},[864],{"#text":865},"semantic anomalies",[867],{"#text":868},"gender stereotypes",[870],{"#text":586},[872],{"#text":587},[874],{"#text":875},"speaker identity",[877],{"#text":878},"pupillometry",[],[881,882,886],{"#text":812},{"p":883},[884],{"#text":885},"Individuals' moral views have been shown to affect their event-related potentials (ERP) response to spoken statements, and people's political ideology has been shown to guide their sentence completion behavior. Using pupillometry, we asked whether political ideology and disgust sensitivity affect online spoken language comprehension. 60 native speakers of English listened to spoken utterances while their pupil size was tracked. Some of those utterances contained grammatical errors, semantic anomalies, or socio-cultural violations, statements incongruent with existing gender stereotypes and perceived speaker identity, such as “I sometimes buy my bras at Hudson's Bay,” spoken by a male speaker. An individual's disgust sensitivity is associated with the Behavioral Immune System, and may be correlated with socio-political attitudes, for example regarding out-group stigmatization. We found that more disgust-sensitive individuals showed greater pupil dilation with semantic anomalies and socio-cultural violations. However, political views differently affected the processing of the two types of violations: whereas more conservative listeners showed a greater pupil response to socio-cultural violations, more progressive listeners engaged more with semantic anomalies, but this effect appeared much later in the pupil record.",{"#text":887},"\n      ",[889,891,1660,1661,2420,2421,2790,2791,3123,3124,3140,3141,3156,3157,3172,3173,3196,3197,3213,3214,3230],{"#text":890},"\n    ",{"sec":892,":@":1657,"anchorId":1659},[893,894,898,899,1059,1060,1158,1159,1267,1268,1279,1280,1322,1323,1368,1369,1373,1374,1548,1549,1624,1625,1656],{"#text":887},{"title":895},[896],{"#text":897},"1. Introduction",{"#text":887},{"p":900},[901,903,910,912,918,920,926,928,934,936,941,943,948,950,956,958,964,966,970,972,975,977,983,984,988,990,994,996,1002,1004,1009,1011,1017,1019,1025,1027,1033,1035,1041,1043,1049,1051,1057],{"#text":902},"Language comprehension is a complex process: The listener has to identify the sounds in a word, recognize the word form, retrieve information associated with this form (Cutler and Clifton, ",{"xref":904,":@":907},[905],{"#text":906},"1999",{"@_ref-type":908,"@_rid":909},"bibr","B13",{"#text":911},"; Sahin et al., ",{"xref":913,":@":916},[914],{"#text":915},"2009",{"@_ref-type":908,"@_rid":917},"B85",{"#text":919},"), and integrate the word into the rapidly unfolding context within a few hundreds of milliseconds (Hagoort and Indefrey, ",{"xref":921,":@":924},[922],{"#text":923},"2014",{"@_ref-type":908,"@_rid":925},"B31",{"#text":927},"; Levinson, ",{"xref":929,":@":932},[930],{"#text":931},"2016",{"@_ref-type":908,"@_rid":933},"B60",{"#text":935},") in an incremental fashion (Altmann and Kamide, ",{"xref":937,":@":939},[938],{"#text":906},{"@_ref-type":908,"@_rid":940},"B6",{"#text":942},"; Sedivy et al., ",{"xref":944,":@":946},[945],{"#text":906},{"@_ref-type":908,"@_rid":947},"B87",{"#text":949},"; Kamide et al., ",{"xref":951,":@":954},[952],{"#text":953},"2003",{"@_ref-type":908,"@_rid":955},"B52",{"#text":957},"; Hagoort and Van Berkum, ",{"xref":959,":@":962},[960],{"#text":961},"2007",{"@_ref-type":908,"@_rid":963},"B32",{"#text":965},"). At the same time, a body of research has shown the importance of context, broadly understood, to real-time language comprehension. For example, an utterance at odds with factual knowledge about the state of affairs in the real world, such as “Dutch trains are ",{"italic":967},[968],{"#text":969},"white",{"#text":971},"” when they are in fact yellow, triggers an N400 signature at the target word ",{"italic":973},[974],{"#text":969},{"#text":976}," (Hagoort et al., ",{"xref":978,":@":981},[979],{"#text":980},"2004",{"@_ref-type":908,"@_rid":982},"B30",{"#text":957},{"xref":985,":@":987},[986],{"#text":961},{"@_ref-type":908,"@_rid":963},{"#text":989},") in the same way as a semantically anomalous word (“Dutch trains are ",{"italic":991},[992],{"#text":993},"sour",{"#text":995},"”). Further, a statement about a peanut being salted can trigger this same N400 response if embedded in a (fictional) story context that does not warrant an inanimate interpretation (Nieuwland and Van Berkum, ",{"xref":997,":@":1000},[998],{"#text":999},"2006",{"@_ref-type":908,"@_rid":1001},"B71",{"#text":1003},"). Important, both speaker-related attributes, for example unfamiliar accents (Porretta et al., ",{"xref":1005,":@":1007},[1006],{"#text":931},{"@_ref-type":908,"@_rid":1008},"B78",{"#text":1010},"; Grey and van Hell, ",{"xref":1012,":@":1015},[1013],{"#text":1014},"2017",{"@_ref-type":908,"@_rid":1016},"B29",{"#text":1018},"; Porretta and Tucker, ",{"xref":1020,":@":1023},[1021],{"#text":1022},"2019",{"@_ref-type":908,"@_rid":1024},"B77",{"#text":1026},"; Arnhold et al., ",{"xref":1028,":@":1031},[1029],{"#text":1030},"2020",{"@_ref-type":908,"@_rid":1032},"B7",{"#text":1034},") or inferred gender (Van Berkum et al., ",{"xref":1036,":@":1039},[1037],{"#text":1038},"2008",{"@_ref-type":908,"@_rid":1040},"B102",{"#text":1042},"), as well as listener-based individual differences (Van den Brink et al., ",{"xref":1044,":@":1047},[1045],{"#text":1046},"2012",{"@_ref-type":908,"@_rid":1048},"B103",{"#text":1050},"; Hubert Lyall and Järvikivi, ",{"xref":1052,":@":1055},[1053],{"#text":1054},"2021",{"@_ref-type":908,"@_rid":1056},"B43",{"#text":1058},") have been found to affect language comprehension ease. In this paper, we investigate whether two further individual difference factors, an individual's propensity to disgust as well as their political views, are associated with their language processing performance.",{"#text":887},{"p":1061},[1062,1064,1070,1072,1077,1079,1083,1085,1091,1093,1098,1100,1105,1107,1111,1113,1118,1120,1125,1127,1132,1134,1138,1140,1144,1145,1149,1151,1156],{"#text":1063},"Disgust is an emotional response to contagious and unsafe situations, such as pathogens or bodily secretions, that is intended to protect an organism from pathogen contamination (Neuberg et al., ",{"xref":1065,":@":1068},[1066],{"#text":1067},"2011",{"@_ref-type":908,"@_rid":1069},"B66",{"#text":1071},"; Schaller and Neuberg, ",{"xref":1073,":@":1075},[1074],{"#text":1046},{"@_ref-type":908,"@_rid":1076},"B86",{"#text":1078},"). Importantly, the feeling of disgust extends beyond simple pathogen avoidance to include ",{"italic":1080},[1081],{"#text":1082},"moral",{"#text":1084}," disgust or purity violations (Wagemans et al., ",{"xref":1086,":@":1089},[1087],{"#text":1088},"2018",{"@_ref-type":908,"@_rid":1090},"B107",{"#text":1092},"), for example triggered by bad moral character (Giner-Sorolla and Chapman, ",{"xref":1094,":@":1096},[1095],{"#text":1014},{"@_ref-type":908,"@_rid":1097},"B24",{"#text":1099},"; Molho et al., ",{"xref":1101,":@":1103},[1102],{"#text":1014},{"@_ref-type":908,"@_rid":1104},"B63",{"#text":1106},"), socially deviant behavior associated with out-groups, or the out-groups themselves (Schaller and Neuberg, ",{"xref":1108,":@":1110},[1109],{"#text":1046},{"@_ref-type":908,"@_rid":1076},{"#text":1112},"; Murray and Schaller, ",{"xref":1114,":@":1116},[1115],{"#text":931},{"@_ref-type":908,"@_rid":1117},"B65",{"#text":1119},"; Dawydiak et al., ",{"xref":1121,":@":1123},[1122],{"#text":1030},{"@_ref-type":908,"@_rid":1124},"B14",{"#text":1126},"). Out-group members effectively end up being treated like infected in-group members (Petersen, ",{"xref":1128,":@":1130},[1129],{"#text":1014},{"@_ref-type":908,"@_rid":1131},"B76",{"#text":1133},"). Further, disgust is closely associated with the ",{"italic":1135},[1136],{"#text":1137},"Behavioral Immune System",{"#text":1139},", whose goal it is to direct attention to a threat of pathogen contamination, in an effort to trigger behaviors that will prevent those pathogens from entering the body (Neuberg et al., ",{"xref":1141,":@":1143},[1142],{"#text":1067},{"@_ref-type":908,"@_rid":1069},{"#text":1112},{"xref":1146,":@":1148},[1147],{"#text":931},{"@_ref-type":908,"@_rid":1117},{"#text":1150},"; Aarøe et al., ",{"xref":1152,":@":1154},[1153],{"#text":1014},{"@_ref-type":908,"@_rid":1155},"B1",{"#text":1157},").",{"#text":887},{"p":1160},[1161,1163,1168,1170,1175,1177,1182,1184,1189,1190,1194,1196,1202,1203,1207,1209,1214,1215,1219,1221,1226,1227,1231,1233,1238,1240,1245,1247,1252,1254,1259,1261,1266],{"#text":1162},"Commonly, disgust sensitivity is higher for women than for men, and for individuals scoring higher in the Big Five traits of Agreeableness, Conscientiousness, and Neuroticism, and lower in Openness (Druschel and Sherman, ",{"xref":1164,":@":1166},[1165],{"#text":906},{"@_ref-type":908,"@_rid":1167},"B18",{"#text":1169},"). Since disgust is easily triggered not just by the presence of actual pathogens, but also by members of a perceived out-group or concepts considered immoral, thresholds for disgust have been shown to predict socio-political attitudes: People who have strong negative attitudes toward socially deviant groups tend to be disgusted more easily, and are more likely to identify as conservative (Faulkner et al., ",{"xref":1171,":@":1173},[1172],{"#text":980},{"@_ref-type":908,"@_rid":1174},"B23",{"#text":1176},"; Inbar et al., ",{"xref":1178,":@":1180},[1179],{"#text":915},{"@_ref-type":908,"@_rid":1181},"B46",{"#text":1183},"; Smith et al., ",{"xref":1185,":@":1187},[1186],{"#text":1067},{"@_ref-type":908,"@_rid":1188},"B91",{"#text":1071},{"xref":1191,":@":1193},[1192],{"#text":1046},{"@_ref-type":908,"@_rid":1076},{"#text":1195},"; Hodson and Dhont, ",{"xref":1197,":@":1200},[1198],{"#text":1199},"2015",{"@_ref-type":908,"@_rid":1201},"B41",{"#text":1112},{"xref":1204,":@":1206},[1205],{"#text":931},{"@_ref-type":908,"@_rid":1117},{"#text":1208},"; Tybur et al., ",{"xref":1210,":@":1212},[1211],{"#text":931},{"@_ref-type":908,"@_rid":1213},"B98",{"#text":1150},{"xref":1216,":@":1218},[1217],{"#text":1014},{"@_ref-type":908,"@_rid":1155},{"#text":1220},"). This link between disgust sensitivity and an individual's political ideology has been traced back to notions of purity and conformity, which, in ancestral populations, may have served the purpose of keeping novel pathogens, that the in-group would have no antibodies against, at bay (Haidt and Graham, ",{"xref":1222,":@":1224},[1223],{"#text":961},{"@_ref-type":908,"@_rid":1225},"B33",{"#text":1176},{"xref":1228,":@":1230},[1229],{"#text":915},{"@_ref-type":908,"@_rid":1181},{"#text":1232},"). Disgust thus shapes an individual's world view, attitudes, and behavior, even down to voting behavior in political elections (Park, ",{"xref":1234,":@":1236},[1235],{"#text":1199},{"@_ref-type":908,"@_rid":1237},"B75",{"#text":1239},"; Shook et al., ",{"xref":1241,":@":1243},[1242],{"#text":1014},{"@_ref-type":908,"@_rid":1244},"B88",{"#text":1246},", ",{"xref":1248,":@":1250},[1249],{"#text":1022},{"@_ref-type":908,"@_rid":1251},"B89",{"#text":1253},"; Karg et al., ",{"xref":1255,":@":1257},[1256],{"#text":1022},{"@_ref-type":908,"@_rid":1258},"B53",{"#text":1260},"; Stewart et al., ",{"xref":1262,":@":1264},[1263],{"#text":1030},{"@_ref-type":908,"@_rid":1265},"B93",{"#text":1157},{"#text":887},{"p":1269},[1270,1272,1277],{"#text":1271},"Thus far, there is no systematic analysis of the influence of disgust sensitivity on real-time language comprehension. However, there is some evidence that individual's moral and political views affect their language processing behavior. Van Berkum et al. (",{"xref":1273,":@":1275},[1274],{"#text":915},{"@_ref-type":908,"@_rid":1276},"B101",{"#text":1278},") showed that linguistic processing cost is not just modulated by factual states of the world, but also by a person's beliefs. They measured participants' ERP responses to statements such as “I think euthanasia is an acceptable vs. unacceptable course of action.” Crucially, their participants either identified as voters of a conservative party or not. They found that words inconsistent with the participants' moral values elicited an early ERP positivity between 200 and 250 ms and a subsequent N400 after the onset of the clashing word (“acceptable” vs. “unacceptable,” depending on the individual's party denomination).",{"#text":887},{"p":1281},[1282,1284,1288,1290,1294,1296,1301,1303,1307,1309,1314,1316,1321],{"#text":1283},"Participants' political ideology has been also shown to affect how they understand inferred causal relations in events involving interpersonal verbs such as ",{"italic":1285},[1286],{"#text":1287},"admire, envy",{"#text":1289},", or ",{"italic":1291},[1292],{"#text":1293},"punish",{"#text":1295},". Marrville (",{"xref":1297,":@":1299},[1298],{"#text":1014},{"@_ref-type":908,"@_rid":1300},"B62",{"#text":1302},") showed that participants' political views significantly predicted whether participants completed sentences fragments such as “Melissa discouraged Sean because.” by continuing with the first or the second NP (Melissa or Shawn). More precisely, Marrville (",{"xref":1304,":@":1306},[1305],{"#text":1014},{"@_ref-type":908,"@_rid":1300},{"#text":1308},") showed that the completions interacted with affective properties of the verbs, namely their valence and dominance, and the participants' political ideology. For example, more conservative participants tended to have more NP1 continuations for low dominant verbs when they were also high valence (thank), but more NP2 continuations when the verb was low valence (criticize). However, this pattern was reversed for more liberal participants. Recently, Niemi et al. (",{"xref":1310,":@":1312},[1311],{"#text":1030},{"@_ref-type":908,"@_rid":1313},"B68",{"#text":1315},") replicated the overall pattern for political views in a similar set-up, suggesting that individuals' moral binding values such as of loyalty, obedience to authority and purity correlated with explicit causal judgments of the NP2 in the event as more likely to have allowed—and perhaps deserved—any harmful outcomes of a particular action. Together these studies suggest that individuals' political ideology is connected to how they interpret interpersonal events and, further, that it might be associated with stronger victim-blaming tendencies in more conservative-leaning participants (see also Niemi and Young, ",{"xref":1317,":@":1319},[1318],{"#text":931},{"@_ref-type":908,"@_rid":1320},"B69",{"#text":1157},{"#text":887},{"p":1324},[1325,1327,1331,1333,1337,1339,1343,1345,1349,1351,1356,1358,1362,1363,1367],{"#text":1326},"Relatedly, recent research suggests that language comprehension is affected by listeners' personality traits that have been linked to moral and political views and disgust sensitivity. Van den Brink et al. (",{"xref":1328,":@":1330},[1329],{"#text":1046},{"@_ref-type":908,"@_rid":1048},{"#text":1332},") showed that more empathetic listeners showed a larger N400 response to (socially) unusual statements (such as a male adult saying “I cannot sleep without my ",{"italic":1334},[1335],{"#text":1336},"teddy bear",{"#text":1338},"”) than their less empathetic counterparts. Hubert Lyall and Järvikivi (",{"xref":1340,":@":1342},[1341],{"#text":1054},{"@_ref-type":908,"@_rid":1056},{"#text":1344},") showed in a pupillometry study that listeners' Big-5 personality traits systematically modulated listeners' real-time language processing in similar scenarios. For example, less open participants showed greater pupil dilation when processing spoken utterances with morpho-syntactic errors (“He frequently have burgers for dinner”), and more introverted listeners showed greater pupil dilation in response to both semantic anomalies (“I often read heads for pleasure” vs. books) and socio-cultural clashes (“I sometimes buy my bras at Hudson's Bay,” vs. “ties,” spoken by a male speaker). More generally, these results suggest that listener-internal factors, such as moral and political views and personality traits, interact with information inferred about the speaker and affect ERP and pupillary responses to stimuli during real-time language processing (see also Van Berkum et al., ",{"xref":1346,":@":1348},[1347],{"#text":1038},{"@_ref-type":908,"@_rid":1040},{"#text":1350},"; Hanulíková et al., ",{"xref":1352,":@":1354},[1353],{"#text":1046},{"@_ref-type":908,"@_rid":1355},"B36",{"#text":1357},"; Porretta et al., ",{"xref":1359,":@":1361},[1360],{"#text":931},{"@_ref-type":908,"@_rid":1008},{"#text":1010},{"xref":1364,":@":1366},[1365],{"#text":1014},{"@_ref-type":908,"@_rid":1016},{"#text":1157},{"#text":887},{"p":1370},[1371],{"#text":1372},"In the present study, we will investigate the extent to which individuals' disgust sensitivity predicts their language processing behavior when listening to statements that include various degrees of deviance from linguistic and social norms and stereotypes. Furthermore, we will compare the effects of individuals' disgust sensitivity and political ideology. Answers to disgust sensitivity scale might reflect the respondent's moral and political views more indirectly than answers to political ideology questionnaires which can be subject to conscious manipulation due to the somewhat obvious nature of the questions.",{"#text":887},{"p":1375},[1376,1378,1383,1385,1390,1392,1397,1399,1405,1406,1412,1414,1420,1422,1428,1430,1436,1438,1443,1444,1448,1450,1455,1457,1462,1464,1470,1472,1477,1478,1482,1484,1489,1491,1495,1497,1501,1503,1509,1510,1514,1516,1521,1523,1527,1528,1532,1534,1539,1541,1546],{"#text":1377},"We used pupillometry to investigate the processing of sentences containing socio-cultural clashes, semantic anomalies, and morpho-syntactic errors. Pupil size is considered an indicator of autonomous nervous system activity in humans (Steinhauer et al., ",{"xref":1379,":@":1381},[1380],{"#text":980},{"@_ref-type":908,"@_rid":1382},"B92",{"#text":1384},"; Gingras et al., ",{"xref":1386,":@":1388},[1387],{"#text":1199},{"@_ref-type":908,"@_rid":1389},"B25",{"#text":1391},"). Specifically, it has been shown to reflect resource allocation (Rondeel et al., ",{"xref":1393,":@":1395},[1394],{"#text":1199},{"@_ref-type":908,"@_rid":1396},"B83",{"#text":1398},") due to cognitive effort, workload, arousal, attention, or affect (Hess and Polt, ",{"xref":1400,":@":1403},[1401],{"#text":1402},"1960",{"@_ref-type":908,"@_rid":1404},"B38",{"#text":1246},{"xref":1407,":@":1410},[1408],{"#text":1409},"1964",{"@_ref-type":908,"@_rid":1411},"B39",{"#text":1413},"; Ahern, ",{"xref":1415,":@":1418},[1416],{"#text":1417},"1978",{"@_ref-type":908,"@_rid":1419},"B2",{"#text":1421},"; Ahern and Beatty, ",{"xref":1423,":@":1426},[1424],{"#text":1425},"1979",{"@_ref-type":908,"@_rid":1427},"B3",{"#text":1429},"; Just and Carpenter, ",{"xref":1431,":@":1434},[1432],{"#text":1433},"1993",{"@_ref-type":908,"@_rid":1435},"B50",{"#text":1437},"; Goldinger and Papesh, ",{"xref":1439,":@":1441},[1440],{"#text":1046},{"@_ref-type":908,"@_rid":1442},"B26",{"#text":1384},{"xref":1445,":@":1447},[1446],{"#text":1199},{"@_ref-type":908,"@_rid":1389},{"#text":1449},"; Winn et al., ",{"xref":1451,":@":1453},[1452],{"#text":1088},{"@_ref-type":908,"@_rid":1454},"B111",{"#text":1456},"). For linguistic stimuli, pupil size has been shown to be responsive to orthographic errors (Thierfelder et al., ",{"xref":1458,":@":1460},[1459],{"#text":1030},{"@_ref-type":908,"@_rid":1461},"B95",{"#text":1463},"), intelligibility (Zekveld et al., ",{"xref":1465,":@":1468},[1466],{"#text":1467},"2010",{"@_ref-type":908,"@_rid":1469},"B114",{"#text":1471},"), ambiguity (Vogelzang et al., ",{"xref":1473,":@":1475},[1474],{"#text":931},{"@_ref-type":908,"@_rid":1476},"B106",{"#text":1449},{"xref":1479,":@":1481},[1480],{"#text":1088},{"@_ref-type":908,"@_rid":1454},{"#text":1483},"), grammatical gender mismatches and semantic anomalies (Demberg and Sayeed, ",{"xref":1485,":@":1487},[1486],{"#text":931},{"@_ref-type":908,"@_rid":1488},"B16",{"#text":1490},"), accentedness (Porretta and Tucker, ",{"xref":1492,":@":1494},[1493],{"#text":1022},{"@_ref-type":908,"@_rid":1024},{"#text":1496},"), complexity (Ahern, ",{"xref":1498,":@":1500},[1499],{"#text":1417},{"@_ref-type":908,"@_rid":1419},{"#text":1502},"; Ben-Nun, ",{"xref":1504,":@":1507},[1505],{"#text":1506},"1986",{"@_ref-type":908,"@_rid":1508},"B10",{"#text":1429},{"xref":1511,":@":1513},[1512],{"#text":1433},{"@_ref-type":908,"@_rid":1435},{"#text":1515},"; Engelhardt et al., ",{"xref":1517,":@":1519},[1518],{"#text":1467},{"@_ref-type":908,"@_rid":1520},"B22",{"#text":1522},"), and individual difference factors (Ahern, ",{"xref":1524,":@":1526},[1525],{"#text":1417},{"@_ref-type":908,"@_rid":1419},{"#text":1421},{"xref":1529,":@":1531},[1530],{"#text":1425},{"@_ref-type":908,"@_rid":1427},{"#text":1533},"; Lõo et al., ",{"xref":1535,":@":1537},[1536],{"#text":931},{"@_ref-type":908,"@_rid":1538},"B61",{"#text":1540},"; Hubert and Järvikivi, ",{"xref":1542,":@":1544},[1543],{"#text":1022},{"@_ref-type":908,"@_rid":1545},"B44",{"#text":1547},"). Importantly, the pupillometry paradigm does not require participants to complete an overt task or action, reducing the possibility of task effects.",{"#text":887},{"p":1550},[1551,1553,1559,1561,1566,1568,1573,1575,1581,1583,1588,1590,1595,1597,1602,1604,1609,1611,1616,1618,1623],{"#text":1552},"We tracked the participants' pupil size as they listened to anomalous or unusual statements, and correlated changes in pupil size with participants' conservatism and disgust sensitivity scores. We were especially interested in pupillary changes in response to socio-cultural violations, statements that are at odds with common gender stereotypes. Stereotypes are cognitive shortcuts (Hilton and von Hippel, ",{"xref":1554,":@":1557},[1555],{"#text":1556},"1996",{"@_ref-type":908,"@_rid":1558},"B40",{"#text":1560},") that are considered part of world knowledge (Carreiras et al., ",{"xref":1562,":@":1564},[1563],{"#text":1556},{"@_ref-type":908,"@_rid":1565},"B12",{"#text":1567},") and activated immediately during language comprehension (Banaji and Hardin, ",{"xref":1569,":@":1571},[1570],{"#text":1556},{"@_ref-type":908,"@_rid":1572},"B8",{"#text":1574},"; Osterhout et al., ",{"xref":1576,":@":1579},[1577],{"#text":1578},"1997",{"@_ref-type":908,"@_rid":1580},"B73",{"#text":1582},"; Pyykkönen et al., ",{"xref":1584,":@":1586},[1585],{"#text":1467},{"@_ref-type":908,"@_rid":1587},"B80",{"#text":1589},"; Hanulíková and Carreiras, ",{"xref":1591,":@":1593},[1592],{"#text":1199},{"@_ref-type":908,"@_rid":1594},"B35",{"#text":1596},"; Molinaro et al., ",{"xref":1598,":@":1600},[1599],{"#text":931},{"@_ref-type":908,"@_rid":1601},"B64",{"#text":1603},"). Importantly, the extent to which individuals engage in stereotyping depends on aspects of their identity (Sibley and Duckitt, ",{"xref":1605,":@":1607},[1606],{"#text":1038},{"@_ref-type":908,"@_rid":1608},"B90",{"#text":1610},"; Akrami et al., ",{"xref":1612,":@":1614},[1613],{"#text":1067},{"@_ref-type":908,"@_rid":1615},"B5",{"#text":1617},"; Quadflieg and Macrae, ",{"xref":1619,":@":1621},[1620],{"#text":1067},{"@_ref-type":908,"@_rid":1622},"B81",{"#text":1157},{"#text":887},{"p":1626},[1627,1629,1633,1635,1640,1642,1647,1649,1654],{"#text":1628},"In our study, socio-cultural violations rely on ",{"italic":1630},[1631],{"#text":1632},"vocal gender",{"#text":1634},", that is, the speaker's gender as inferred from their voice. Voices with lower formant frequencies, a lower fundamental frequency, and greater resonance are typically interpreted as male (Strand, ",{"xref":1636,":@":1638},[1637],{"#text":906},{"@_ref-type":908,"@_rid":1639},"B94",{"#text":1641},"; Ko et al., ",{"xref":1643,":@":1645},[1644],{"#text":999},{"@_ref-type":908,"@_rid":1646},"B56",{"#text":1648},"). Vocal gender has recently been found to affect the comprehension of segments containing stereotypically male or female occupations (Grant et al., ",{"xref":1650,":@":1652},[1651],{"#text":1030},{"@_ref-type":908,"@_rid":1653},"B28",{"#text":1655},"). We expected more disgust-sensitive individuals to allocate more resources, as indicated by a larger pupil size, to anomalous stimuli; specifically, we expected higher disgust sensitivity and conservatism scores to be correlated with a stronger response to socio-cultural clashes, due to a stronger tendency to stigmatize.",{"#text":890},{"@_sec-type":1658,"@_id":1659},"intro","s1",{"#text":890},{"sec":1662,":@":2417,"anchorId":2419},[1663,1664,1668,1669,1749,1750,2182,2183,2220,2221,2416],{"#text":887},{"title":1665},[1666],{"#text":1667},"2. Methods",{"#text":887},{"sec":1670},[1671,1672,1676,1677,1710,1711,1748],{"#text":812},{"title":1673},[1674],{"#text":1675},"2.1. Participants",{"#text":812},{"p":1678},[1679,1681,1685,1687,1690,1692,1696,1698,1702,1704,1708],{"#text":1680},"82 participants completed the main experiment and post-tests for this study, which received research ethics committee approval from Research Ethics Board 2 at the University of Alberta. While non-native speakers of English were allowed to participate in the study, their data (",{"italic":1682},[1683],{"#text":1684},"n",{"#text":1686}," = 14) was not used in the analyses reported below. Data from participants whose comprehension question accuracy was below 80% (",{"italic":1688},[1689],{"#text":1684},{"#text":1691}," = 8) were removed, as attention to and comprehension of the experiment stimuli could not be guaranteed in those cases (min = 75%; max = 100%; mean = 93:7%, 95% CI [92.1, 95.3]). Trials during which more than 33% of data points were recorded as missing data, i.e., ",{"monospace":1693},[1694],{"#text":1695},"N/A",{"#text":1697},", were excluded from analyses (n = 782; 8% of trials). The analyses in this paper are thus based on the data obtained from 60 native speakers of English (",{"italic":1699},[1700],{"#text":1701},"male/female",{"#text":1703}," = 8/52; ",{"italic":1705},[1706],{"#text":1707},"age min/max",{"#text":1709}," = 17/83, mean = 24.9, 95% CI [21.5, 28.3]). Of those 60 participants, 38 were recruited from the University of Alberta undergraduate linguistics student pool and received course credit for their participation; the remaining 22 participants were recruited from the general population, with no restrictions on age or background, and received a small monetary compensation for their participation.",{"#text":812},{"p":1712},[1713,1715,1719,1721,1725,1727,1731,1733,1736,1740,1742,1746],{"#text":1714},"A two-tailed ",{"italic":1716},[1717],{"#text":1718},"t",{"#text":1720},"-test showed that the age distribution differed significantly between the two recruitment strategies [mean",{"sub":1722},[1723],{"#text":1724},"external",{"#text":1726}," = 33.5, 95% CI [25.3, 41.7]; mean",{"sub":1728},[1729],{"#text":1730},"internal",{"#text":1732}," = 19.9, 95% CI [19, 20.8]; ",{"italic":1734},[1735],{"#text":1718},{"sub":1737},[1738],{"#text":1739},"(21.48)",{"#text":1741}," = −3.21, ",{"italic":1743},[1744],{"#text":1745},"p",{"#text":1747}," = 0.004], with externally recruited participants being significantly older and their age distribution being much wider.",{"#text":887},{"#text":887},{"sec":1751},[1752,1753,1757,1758,1868,1869,2123,2124,2148,2149,2160,2161,2181],{"#text":812},{"title":1754},[1755],{"#text":1756},"2.2. Materials and Design",{"#text":812},{"p":1759},[1760,1762,1769,1771,1778,1780,1786,1788,1794,1796,1801,1803,1808,1810,1815,1817,1822,1824,1830,1831,1835,1837,1841,1843,1849,1850,1854,1856,1860,1862,1867],{"#text":1761},"We created 240 utterances for experimental stimuli (see ",{"xref":1763,":@":1766},[1764],{"#text":1765},"Table 1",{"@_ref-type":1767,"@_rid":1768},"table","T1",{"#text":1770},"; the full list of stimuli in ",{"xref":1772,":@":1775},[1773],{"#text":1774},"Supplementary Materials",{"@_ref-type":1776,"@_rid":1777},"supplementary-material","SM1",{"#text":1779},"). While the focus of our paper is on the processing of socio-cultural violations, morpho-syntactic errors and semantic anomalies were included to compare these pragmatic deviations, which violate common expectations given the context, to more language-internal, structural and semantic-level violations. Both morpho-syntactic errors and semantic anomalies have been shown to result in processing delays for reading and listening times (Just and Carpenter, ",{"xref":1781,":@":1784},[1782],{"#text":1783},"1980",{"@_ref-type":908,"@_rid":1785},"B49",{"#text":1787},"; Braze et al., ",{"xref":1789,":@":1792},[1790],{"#text":1791},"2002",{"@_ref-type":908,"@_rid":1793},"B11",{"#text":1795},"; De Vincenzi et al., ",{"xref":1797,":@":1799},[1798],{"#text":953},{"@_ref-type":908,"@_rid":1800},"B15",{"#text":1802},"; Ditman et al., ",{"xref":1804,":@":1806},[1805],{"#text":961},{"@_ref-type":908,"@_rid":1807},"B17",{"#text":1809},"; Tokowicz and Warren, ",{"xref":1811,":@":1813},[1812],{"#text":1467},{"@_ref-type":908,"@_rid":1814},"B96",{"#text":1816},"), as exemplified in augmented P600 and N400 ERP amplitudes, respectively (Kutas and Hillyard, ",{"xref":1818,":@":1820},[1819],{"#text":1783},{"@_ref-type":908,"@_rid":1821},"B59",{"#text":1823},"; Ni et al., ",{"xref":1825,":@":1828},[1826],{"#text":1827},"1998",{"@_ref-type":908,"@_rid":1829},"B67",{"#text":1787},{"xref":1832,":@":1834},[1833],{"#text":1791},{"@_ref-type":908,"@_rid":1793},{"#text":1836},"; Hagoort and Indefrey, ",{"xref":1838,":@":1840},[1839],{"#text":923},{"@_ref-type":908,"@_rid":925},{"#text":1842},"), but also in larger pupil dilation (Beatty, ",{"xref":1844,":@":1847},[1845],{"#text":1846},"1982",{"@_ref-type":908,"@_rid":1848},"B9",{"#text":1515},{"xref":1851,":@":1853},[1852],{"#text":1467},{"@_ref-type":908,"@_rid":1520},{"#text":1855},"; Demberg and Sayeed, ",{"xref":1857,":@":1859},[1858],{"#text":931},{"@_ref-type":908,"@_rid":1488},{"#text":1861},"; Zekveld et al., ",{"xref":1863,":@":1865},[1864],{"#text":1088},{"@_ref-type":908,"@_rid":1866},"B113",{"#text":1157},{"#text":812},{"table-wrap":1870,":@":2121},[1871,1872,1875,1876,1885,1886,2120],{"#text":806},{"label":1873},[1874],{"#text":1765},{"#text":806},{"caption":1877},[1878,1880,1884],{"#text":1879},"\n            ",{"p":1881},[1882],{"#text":1883},"Overview of stimuli and experimental conditions.",{"#text":806},{"#text":806},{"table":1887,":@":2117},[1888,1889,1945,1946,2116],{"#text":1879},{"thead":1890},[1891,1893,1944],{"#text":1892},"\n              ",{"tr":1894},[1895,1897,1899,1900,1912,1913,1923,1924,1933,1934,1943],{"#text":1896},"\n                ",{"th":1898},[],{"#text":1896},{"th":1901,":@":1909},[1902,1904,1908],{"#text":1903},"\n                  ",{"bold":1905},[1906],{"#text":1907},"Clash type",{"#text":1896},{"@_valign":1910,"@_align":1911},"top","center",{"#text":1896},{"th":1914,":@":1921},[1915,1916,1920],{"#text":1903},{"bold":1917},[1918],{"#text":1919},"# of stimuli",{"#text":1896},{"@_valign":1910,"@_align":1922},"left",{"#text":1896},{"th":1925,":@":1932},[1926,1927,1931],{"#text":1903},{"bold":1928},[1929],{"#text":1930},"Clash description",{"#text":1896},{"@_valign":1910,"@_align":1922},{"#text":1896},{"th":1935,":@":1942},[1936,1937,1941],{"#text":1903},{"bold":1938},[1939],{"#text":1940},"Example stimulus",{"#text":1896},{"@_valign":1910,"@_align":1922},{"#text":1892},{"#text":1879},{"#text":1879},{"tbody":1947},[1948,1949,2003,2004,2042,2043,2084,2085,2115],{"#text":1892},{"tr":1950},[1951,1952,1959,1960,1965,1966,1971,1972,1981,1982,2002],{"#text":1896},{"td":1953,":@":1956},[1954],{"#text":1955},"Controls",{"@_valign":1957,"@_align":1911,"@_rowspan":1958},"middle",4,{"#text":1896},{"td":1961,":@":1964},[1962],{"#text":1963},"Socio-cultural",{"@_valign":1910,"@_align":1911},{"#text":1896},{"td":1967,":@":1970},[1968],{"#text":1969},"120",{"@_valign":1910,"@_align":1922},{"#text":1896},{"td":1973,":@":1980},[1974,1976,1978],{"#text":1975},"Clash with the speaker's perceived",{"break":1977},[],{"#text":1979}," Identity as per common gender stereotypes",{"@_valign":1910,"@_align":1922},{"#text":1896},{"td":1983,":@":2001},[1984,1985,1995,1997,1999],{"#text":1903},{"italic":1986},[1987,1989,1993],{"#text":1988},"I usually buy my ",{"bold":1990},[1991],{"#text":1992},"bras",{"#text":1994}," at Hudson's Bay",{"#text":1996},", spoken by",{"break":1998},[],{"#text":2000}," a male speaker.",{"@_valign":1910,"@_align":1922},{"#text":1892},{"#text":1892},{"tr":2005},[2006,2007,2012,2013,2018,2019,2024,2025,2041],{"#text":1896},{"td":2008,":@":2011},[2009],{"#text":2010},"Morpho-syntactic",{"@_valign":1910,"@_align":1911},{"#text":1896},{"td":2014,":@":2017},[2015],{"#text":2016},"56",{"@_valign":1910,"@_align":1922},{"#text":1896},{"td":2020,":@":2023},[2021],{"#text":2022},"Violation of subject-verb agreement",{"@_valign":1910,"@_align":1922},{"#text":1896},{"td":2026,":@":2040},[2027,2028,2038],{"#text":1903},{"italic":2029},[2030,2032,2036],{"#text":2031},"She usually ",{"bold":2033},[2034],{"#text":2035},"drive",{"#text":2037}," her car slowly in the snow",{"#text":2039},".",{"@_valign":1910,"@_align":1922},{"#text":1892},{"#text":1892},{"tr":2044},[2045,2046,2051,2052,2057,2058,2067,2068,2083],{"#text":1896},{"td":2047,":@":2050},[2048],{"#text":2049},"Semantic",{"@_valign":1910,"@_align":1911},{"#text":1896},{"td":2053,":@":2056},[2054],{"#text":2055},"32",{"@_valign":1910,"@_align":1922},{"#text":1896},{"td":2059,":@":2066},[2060,2062,2064],{"#text":2061},"Semantic mismatch between the verb",{"break":2063},[],{"#text":2065}," and the object",{"@_valign":1910,"@_align":1922},{"#text":1896},{"td":2069,":@":2082},[2070,2071,2081],{"#text":1903},{"italic":2072},[2073,2075,2079],{"#text":2074},"People often read ",{"bold":2076},[2077],{"#text":2078},"heads",{"#text":2080}," for pleasure at night",{"#text":2039},{"@_valign":1910,"@_align":1922},{"#text":1892},{"#text":1892},{"tr":2086},[2087,2088,2093,2094,2098,2099,2104,2105,2114],{"#text":1896},{"td":2089,":@":2092},[2090],{"#text":2091},"Filler",{"@_valign":1910,"@_align":1911},{"#text":1896},{"td":2095,":@":2097},[2096],{"#text":2055},{"@_valign":1910,"@_align":1922},{"#text":1896},{"td":2100,":@":2103},[2101],{"#text":2102},"N/A - non-anomalous",{"@_valign":1910,"@_align":1922},{"#text":1896},{"td":2106,":@":2113},[2107,2108,2112],{"#text":1903},{"italic":2109},[2110],{"#text":2111},"Chickens normally live in a coop",{"#text":2039},{"@_valign":1910,"@_align":1922},{"#text":1892},{"#text":1879},{"#text":806},{"@_frame":2118,"@_rules":2119},"hsides","groups",{"#text":812},{"@_position":2122,"@_id":1768},"float",{"#text":812},{"p":2125},[2126,2128,2134,2136,2140,2142,2146],{"#text":2127},"All utterances followed the same syntactic pattern to ensure comparability across regions (Jegerski and VanPatten, ",{"xref":2129,":@":2132},[2130],{"#text":2131},"2013",{"@_ref-type":908,"@_rid":2133},"B47",{"#text":2135},"). For item recording, items were presented to one male and one female native speaker of Western Canadian English in random order, and recorded in a sound-treated booth using a ",{"italic":2137},[2138],{"#text":2139},"Korg MR-2000S",{"#text":2141}," studio recorder with a ",{"italic":2143},[2144],{"#text":2145},"Countryman E6",{"#text":2147}," earset microphone. Item recordings in which the prosody sounded noticeably different from those of other items were re-recorded with the speaker. Utterances were then distributed across four lists, counterbalanced for error condition (non-anomalous baseline vs. anomalous) and speaker gender (male vs. female). Each list included the same 32 filler utterances, resulting in 135 utterances per list. Each participant was presented with one list (and, accordingly, each item only once, in just one condition and spoken by one speaker).",{"#text":812},{"p":2150},[2151,2153,2158],{"#text":2152},"Additionally, all items were previously rated for acceptability in a separate, off-line Likert-style ratings experiment, by a separate set of participants (see Hubert Lyall, ",{"xref":2154,":@":2156},[2155],{"#text":1022},{"@_ref-type":908,"@_rid":2157},"B42",{"#text":2159},"; 99 native speakers of English recruited from the pool of undergraduate linguistics students at the [University of Alberta]; male/female = 59/40 (60%/40%); age min/max = 17/31; mean = 20.4 years). The resulting average per-item ratings were fed into the statistical models reported below as a numerical predictor.",{"#text":812},{"p":2162},[2163,2165,2169,2171,2175,2176,2180],{"#text":2164},"In the main experiment, a comprehension question was presented to the participant after approximately 30% of items (i.e., each participant was presented with a question after 38 to 41 items total). Questions were 128 simple ",{"italic":2166},[2167],{"#text":2168},"yes/no",{"#text":2170}," questions in line with well-established world knowledge, such as “Do giraffes have long necks?” after the unrelated filler item “Giraffes always have very long necks,” to check for both attention to the experiment, and comprehension of the auditory stimuli that were presented (De Vincenzi et al., ",{"xref":2172,":@":2174},[2173],{"#text":953},{"@_ref-type":908,"@_rid":1800},{"#text":1350},{"xref":2177,":@":2179},[2178],{"#text":1046},{"@_ref-type":908,"@_rid":1355},{"#text":1157},{"#text":887},{"#text":887},{"sec":2184},[2185,2186,2190,2191,2214,2215,2219],{"#text":812},{"title":2187},[2188],{"#text":2189},"2.3. Procedure",{"#text":812},{"p":2192},[2193,2195,2201,2202,2206,2208,2212],{"#text":2194},"After introducing the participants to the experimental setup, they were seated in an adjustable chair in a dimly lit experiment booth at the Centre for Comparative Psycholinguistics, University of Alberta. Light levels were kept constant throughout the experiment and for all participants. Participants were asked to place their head on a chinrest for additional stability, and to ensure a constant screen-to-eye distance. They were then instructed to follow the instructions on the screen to calibrate the eye-tracker, and to complete the experiment. During the experiment, the pupil size of the participant's right eye (cf. Kahneman and Beatty, ",{"xref":2196,":@":2199},[2197],{"#text":2198},"1966",{"@_ref-type":908,"@_rid":2200},"B51",{"#text":1018},{"xref":2203,":@":2205},[2204],{"#text":1022},{"@_ref-type":908,"@_rid":1024},{"#text":2207},") was recorded at 250 Hz using an ",{"italic":2209},[2210],{"#text":2211},"EyeLink 1000",{"#text":2213}," system on a desktop PC.",{"#text":812},{"p":2216},[2217],{"#text":2218},"Each trial began with a one-point drift correct, immediately followed by the display of a fixation cross at the center of the screen. Pupil size was recorded from the start of the fixation cross. Two thousand milliseconds later, the audio stimulus began to play, and pupil size was recorded until 500 ms after audio offset. After an inter-stimulus interval of 3,000 ms, to allow pupil dilation to return to baseline, the next trial began. Participants were given longer breaks approximately every thirty-five trials; the length of these longer breaks was up to the participant. The main experiment took between 20 and 30 min to complete. Participants then moved on to the post-tests described below.",{"#text":887},{"#text":887},{"sec":2222},[2223,2224,2228,2229,2336,2337,2415],{"#text":812},{"title":2225},[2226],{"#text":2227},"2.4. Post-questionnaires",{"#text":812},{"p":2230},[2231,2233,2237,2239,2243,2245,2251,2253,2258,2260,2264,2265,2270,2272,2277,2278,2282,2284,2290,2292,2297,2299,2304,2305,2309,2310,2314,2316,2321,2323,2327,2329,2334],{"#text":2232},"Participants completed three post-test questionnaires after the main experiment session, so as not to prime them toward the purpose of the study. To assess the influence of disgust sensitivity on language comprehension, the ",{"italic":2234},[2235],{"#text":2236},"Disgust Scale - Revised",{"#text":2238}," [",{"italic":2240},[2241],{"#text":2242},"DS-R",{"#text":2244},"; (Haidt et al., ",{"xref":2246,":@":2249},[2247],{"#text":2248},"1994",{"@_ref-type":908,"@_rid":2250},"B34",{"#text":2252},") modified by Olatunji et al. (",{"xref":2254,":@":2256},[2255],{"#text":961},{"@_ref-type":908,"@_rid":2257},"B72",{"#text":2259},")], which was also used in, for example, Inbar et al., ",{"xref":2261,":@":2263},[2262],{"#text":915},{"@_ref-type":908,"@_rid":1181},{"#text":1246},{"xref":2266,":@":2268},[2267],{"#text":1046},{"@_ref-type":908,"@_rid":2269},"B45",{"#text":2271},"; Ahn et al., ",{"xref":2273,":@":2275},[2274],{"#text":923},{"@_ref-type":908,"@_rid":2276},"B4",{"#text":1540},{"xref":2279,":@":2281},[2280],{"#text":1022},{"@_ref-type":908,"@_rid":1545},{"#text":2283},", was administered to participants. Participant's political views were assessed using a Wilson-Patterson-type test (Wilson and Patterson, ",{"xref":2285,":@":2288},[2286],{"#text":2287},"1968",{"@_ref-type":908,"@_rid":2289},"B110",{"#text":2291},"), the full version of which can be found in section 1 (",{"xref":2293,":@":2296},[2294],{"#text":2295},"Supplementary Material",{"@_ref-type":1776,"@_rid":1777},{"#text":2298},"). This test was also chosen for results to be directly comparable to recent research involving political values and disgust sensitivity (Jost et al., ",{"xref":2300,":@":2302},[2301],{"#text":953},{"@_ref-type":908,"@_rid":2303},"B48",{"#text":1183},{"xref":2306,":@":2308},[2307],{"#text":1067},{"@_ref-type":908,"@_rid":1188},{"#text":2271},{"xref":2311,":@":2313},[2312],{"#text":923},{"@_ref-type":908,"@_rid":2276},{"#text":2315},"; Hatemi and Verhulst, ",{"xref":2317,":@":2319},[2318],{"#text":1199},{"@_ref-type":908,"@_rid":2320},"B37",{"#text":2322},"). Note that the Wilson-Patterson scale is a conservatism scale; as such, high scores signify a conservative outlook. Both the political questionnaire and the DS-R were coded in ",{"italic":2324},[2325],{"#text":2326},"E-Prime",{"#text":2328}," 2.0 (Psychology Software Tools Inc., ",{"xref":2330,":@":2332},[2331],{"#text":1046},{"@_ref-type":908,"@_rid":2333},"B79",{"#text":2335},"). In addition, data on the participants' language background, including proficiency in other languages and places the participant had lived, was collected via a pen-and-paper language background questionnaire.",{"#text":812},{"p":2338},[2339,2341,2346,2347,2351,2352,2356,2357,2361,2362,2366,2368,2371,2373,2377,2379,2382,2384,2389,2391,2394,2396,2399,2401,2404,2408,2410,2413],{"#text":2340},"Some studies have found a link between higher disgust sensitivity and a conservative world view (Graham et al., ",{"xref":2342,":@":2344},[2343],{"#text":915},{"@_ref-type":908,"@_rid":2345},"B27",{"#text":1176},{"xref":2348,":@":2350},[2349],{"#text":915},{"@_ref-type":908,"@_rid":1181},{"#text":1246},{"xref":2353,":@":2355},[2354],{"#text":1046},{"@_ref-type":908,"@_rid":2269},{"#text":1112},{"xref":2358,":@":2360},[2359],{"#text":931},{"@_ref-type":908,"@_rid":1117},{"#text":1150},{"xref":2363,":@":2365},[2364],{"#text":1014},{"@_ref-type":908,"@_rid":1155},{"#text":2367},"); within our participant sample, we observed a weak, non-significant (",{"italic":2369},[2370],{"#text":1745},{"#text":2372}," > 0.05) trend in the same direction, that is, for individuals with higher disgust sensitivity to also be more conservative (",{"italic":2374},[2375],{"#text":2376},"r",{"#text":2378}," = 0.22, ",{"italic":2380},[2381],{"#text":1745},{"#text":2383}," = 0.1) (",{"xref":2385,":@":2388},[2386],{"#text":2387},"Supplementary Figure 1",{"@_ref-type":1776,"@_rid":1777},{"#text":2390},"). We did not observe significant differences in the distributions of either political views or disgust sensitivity scores between men and women; however, externally recruited participants were significantly less disgust sensitive than their internally recruited peers [mean",{"sub":2392},[2393],{"#text":1724},{"#text":2395}," = 1.71, 95% CI [1.52, 1.9]; mean",{"sub":2397},[2398],{"#text":1730},{"#text":2400}," = 2.16, 95% CI [1.97, 2.35]; ",{"italic":2402},[2403],{"#text":1718},{"sub":2405},[2406],{"#text":2407},"(53.92)",{"#text":2409}," = 3.25, ",{"italic":2411},[2412],{"#text":1745},{"#text":2414}," = 0.002].",{"#text":887},{"#text":890},{"@_sec-type":2418,"@_id":2419},"methods","s2",{"#text":890},{"sec":2422,":@":2787,"anchorId":2789},[2423,2424,2428,2429,2576,2577,2609,2610,2737,2738,2786],{"#text":887},{"title":2425},[2426],{"#text":2427},"3. Results",{"#text":887},{"sec":2430},[2431,2432,2436,2437,2461,2462,2575],{"#text":812},{"title":2433},[2434],{"#text":2435},"3.1. Data Pre-processing and Model-Fitting",{"#text":812},{"p":2438},[2439,2441,2445,2447,2452,2454,2459],{"#text":2440},"The raw pupillometry data was pre-processed in ",{"monospace":2442},[2443],{"#text":2444},"R",{"#text":2446}," (Version 3.6.3, R Core Team, ",{"xref":2448,":@":2450},[2449],{"#text":1030},{"@_ref-type":908,"@_rid":2451},"B82",{"#text":2453},") and RStudio (Version 1.3.959, RStudio Team, ",{"xref":2455,":@":2457},[2456],{"#text":1030},{"@_ref-type":908,"@_rid":2458},"B84",{"#text":2460},"), with one data point being one pupil size sample. Blinks and the adjacent 20 data points (10 to the left, 10 to the right) were removed, and the onset of each target word was centered at 0 ms. Baseline pupil sizes were calculated per participant per trial over the time period of −200 ms until onset of the target word, and data points further than 2.5 SD's from the respective participant-trial baseline (3% of total data points) were removed.",{"#text":812},{"p":2463},[2464,2466,2470,2471,2475,2477,2481,2483,2488,2490,2494,2496,2501,2503,2508,2510,2515,2517,2520,2521,2525,2527,2532,2534,2538,2540,2545,2547,2551,2553,2557,2559,2563,2565,2569,2570,2574],{"#text":2465},"All results reported below were obtained through generalized additive mixed effects modeling (",{"italic":2467},[2468],{"#text":2469},"GAM modeling",{"#text":1289},{"italic":2472},[2473],{"#text":2474},"GAMM",{"#text":2476},") using the ",{"monospace":2478},[2479],{"#text":2480},"mgcv",{"#text":2482}," (Version 1.8-28, Wood, ",{"xref":2484,":@":2486},[2485],{"#text":1067},{"@_ref-type":908,"@_rid":2487},"B112",{"#text":2489},") and ",{"monospace":2491},[2492],{"#text":2493},"itsadug",{"#text":2495}," (Version 2.3, van Rij et al., ",{"xref":2497,":@":2499},[2498],{"#text":1014},{"@_ref-type":908,"@_rid":2500},"B105",{"#text":2502},") packages in R, with relative pupil size as the dependent variable. GAM modeling is well suited to time-series data, such as pupillometry, as it is able to capture non-linear interactions between continuous predictors without losing information in time-binning (Tremblay and Newman, ",{"xref":2504,":@":2506},[2505],{"#text":1199},{"@_ref-type":908,"@_rid":2507},"B97",{"#text":2509},"; van Rij et al., ",{"xref":2511,":@":2513},[2512],{"#text":1022},{"@_ref-type":908,"@_rid":2514},"B104",{"#text":2516},"). All models included a random smooth for participant by time, and a random intercept by item to account for individual differences within the stimuli, and for random variance between participants beyond the factors of interest. Average item rating, time (−200 to 2,000 ms from target word onset), and disgust sensitivity and political ideology scores were tested as fixed predictors. Visualizations were produced using the ",{"monospace":2518},[2519],{"#text":2493},{"#text":1246},{"monospace":2522},[2523],{"#text":2524},"ggplot2",{"#text":2526}," (Version 3.2.1, Wickham, ",{"xref":2528,":@":2530},[2529],{"#text":931},{"@_ref-type":908,"@_rid":2531},"B109",{"#text":2533},"), and ",{"monospace":2535},[2536],{"#text":2537},"ggpubr",{"#text":2539}," (Version 0.3.0, Kassambara, ",{"xref":2541,":@":2543},[2542],{"#text":1030},{"@_ref-type":908,"@_rid":2544},"B54",{"#text":2546},") packages. Data in the time window from 200 ms before target word onset to 2,000 ms after was analyzed. The models were fitted using a forwards step-wise selection procedure, where the inclusion of variables was evaluated using a combination of a χ",{"sup":2548},[2549],{"#text":2550},"2",{"#text":2552}," test of REML scores via the ",{"monospace":2554},[2555],{"#text":2556},"compareML()",{"#text":2558}," function, visual inspection, and the estimated p-value of the smooth parameter via the ",{"monospace":2560},[2561],{"#text":2562},"report_stats()",{"#text":2564}," function (see e.g., Porretta and Tucker, ",{"xref":2566,":@":2568},[2567],{"#text":1022},{"@_ref-type":908,"@_rid":1024},{"#text":2509},{"xref":2571,":@":2573},[2572],{"#text":1022},{"@_ref-type":908,"@_rid":2514},{"#text":1157},{"#text":887},{"#text":887},{"sec":2578},[2579,2580,2584,2585,2608],{"#text":812},{"title":2581},[2582],{"#text":2583},"3.2. Morpho-Syntactic Errors",{"#text":812},{"p":2586},[2587,2589,2594,2596,2599,2601,2606],{"#text":2588},"Changes in pupil size in response to morpho-syntactic errors were modeled as a control condition (see ",{"xref":2590,":@":2593},[2591],{"#text":2592},"Supplementary Table 1",{"@_ref-type":1776,"@_rid":1777},{"#text":2595}," for the model output). The results showed significant non-linear effects of Time, Item Rating, and and interaction between the two (all ",{"italic":2597},[2598],{"#text":1745},{"#text":2600},"'s \u003C 0.0001). Items that contained a morpho-syntactic error were associated with significantly larger pupil dilation (",{"xref":2602,":@":2605},[2603],{"#text":2604},"Supplementary Figure 2",{"@_ref-type":1776,"@_rid":1777},{"#text":2607},"), suggesting that the pupillometry paradigm was able to track changes in pupil size associated with a processing difficulty at an erroneous word. Individual disgust sensitivity and political views were tested as model predictors, but were not found to be associated with significant effects on pupil dilation in this condition.",{"#text":887},{"#text":887},{"sec":2611},[2612,2613,2617,2618,2670,2671,2708,2709,2724,2725,2736],{"#text":812},{"title":2614},[2615],{"#text":2616},"3.3. Semantic Anomalies",{"#text":812},{"p":2619},[2620,2622,2627,2629,2632,2634,2637,2639,2642,2644,2647,2649,2652,2654,2661,2663,2668],{"#text":2621},"The model output is depicted in ",{"xref":2623,":@":2626},[2624],{"#text":2625},"Supplementary Table 2",{"@_ref-type":1776,"@_rid":1777},{"#text":2628},". The results showed significant non-linear effects of Time, Item Rating, and an interaction between these (",{"italic":2630},[2631],{"#text":1745},{"#text":2633}," \u003C 0.0001). In addition, we found a significant interaction between Disgust Sensitivity and Time (",{"italic":2635},[2636],{"#text":1745},{"#text":2638},"'s \u003C 0.0001) and, importantly, a three-way non-linear interaction between Disgust Sensitivity, Time, and Item Rating (",{"italic":2640},[2641],{"#text":1745},{"#text":2643},"'s \u003C 0.0001). Additionally, there was a significant interaction between Political Ideology and Item rating (",{"italic":2645},[2646],{"#text":1745},{"#text":2648}," \u003C 0.0001) that was qualified by a three-way interaction with Time (",{"italic":2650},[2651],{"#text":1745},{"#text":2653}," \u003C 0.0001). In order to assess these interactions, in what follows, we will inspect the respective difference plots that depict the difference in pupil size between the anomalous/clashing and the non-anomalous/non-clashing conditions by Time from the target word onset (x-axis, 0–1,500 ms) and participants' Political Ideology (",{"xref":2655,":@":2658},[2656],{"#text":2657},"Figure 1A",{"@_ref-type":2659,"@_rid":2660},"fig","F1",{"#text":2662},") and Disgust Sensitivity (",{"xref":2664,":@":2667},[2665],{"#text":2666},"Figure 1B",{"@_ref-type":2659,"@_rid":2660},{"#text":2669},") scores.",{"#text":812},{"fig":2672,":@":2707},[2673,2674,2678,2679,2699,2700,2706],{"#text":806},{"label":2675},[2676],{"#text":2677},"Figure 1",{"#text":806},{"caption":2680},[2681,2682,2698],{"#text":1879},{"p":2683},[2684,2686,2690,2692,2696],{"#text":2685},"Difference in pupil size in anomalous/clashing conditions compared to non-anomalous/non-clashing conditions by Political Views and Disgust Sensitivity (y-axis) and Time from the onset of the target word (x-axis) for semantic anomalies (",{"bold":2687},[2688],{"#text":2689},"A,C",{"#text":2691},", respectively) and socio-cultural clashes (",{"bold":2693},[2694],{"#text":2695},"B,D",{"#text":2697},", respectively).",{"#text":806},{"#text":806},{"graphic":2701,":@":2702},[],{"@_mimetype":421,"@_mime-subtype":2703,"@_xmlns:xlink":2704,"@_xlink:href":2705},"tiff","http://www.w3.org/1999/xlink","fpsyg-12-699071-g0001.tif",{"#text":812},{"@_id":2660,"@_position":2122},{"#text":812},{"p":2710},[2711,2712,2716,2718,2722],{"#text":806},{"xref":2713,":@":2715},[2714],{"#text":2677},{"@_ref-type":2659,"@_rid":2660},{"#text":2717}," visualizes the three-way interaction between time since onset of the target word (on the x-axis), the respective individual difference variable (disgust sensitivity or political views on the y-axis), and clash condition (implied; see details below). The participant's pupil size is represented via a color scale: Thus, the difference in clashing vs. non-clashing conditions is implied in this type of plot; the color scale indicates the difference in pupil size when a listener encounters a clashing statement, as compared to when they encounter a non-anomalous statement. A blue color indicates a small (or even negative) change in pupil size when listening to a clashing statement (as compared to a non-anomalous statement), whereas a yellow or orange color indicates a larger dilation. We thus see that for the three-way interaction between time, the semantic anomaly condition, and political views in ",{"xref":2719,":@":2721},[2720],{"#text":2657},{"@_ref-type":2659,"@_rid":2660},{"#text":2723},", it is more liberal listeners (lower half of the plot, y-axis) who experience a larger change in pupil dilation: there is a gradual change from blue to green color starting around 500 ms that starts turning into yellow and orange around 1,000 ms after onset of the target word.",{"#text":812},{"p":2726},[2727,2729,2734],{"#text":2728},"As to the interaction with disgust sensitivity, visualized in ",{"xref":2730,":@":2733},[2731],{"#text":2732},"Figure 1C",{"@_ref-type":2659,"@_rid":2660},{"#text":2735},", listeners with higher than average disgust sensitivity (upper half of y-axis) showed a larger pupil dilation starting already around 300ms after the onset of the target word.",{"#text":887},{"#text":887},{"sec":2739},[2740,2741,2745,2746,2785],{"#text":812},{"title":2742},[2743],{"#text":2744},"3.4. Socio-Cultural Violations",{"#text":812},{"p":2747},[2748,2750,2755,2757,2762,2764,2767,2769,2772,2774,2777,2779,2783],{"#text":2749},"Socio-cultural violations, as the main focus of analysis in this paper, are defined as statements violating common expectations regarding what a speaker of the perceived gender would be expected to say, such as an adult male saying “I cannot sleep without my teddy bear in my arms.” The final model output can be found in ",{"xref":2751,":@":2754},[2752],{"#text":2753},"Supplementary Table 3",{"@_ref-type":1776,"@_rid":1777},{"#text":2756},". The results are depicted in ",{"xref":2758,":@":2761},[2759],{"#text":2760},"Figures 1B,D",{"@_ref-type":2659,"@_rid":2660},{"#text":2763},". Firstly, we found significant effects of Time and Item Rating, the latter suggesting that statements clashing with the speaker's perceived gender identity indeed elicited larger pupil dilation than the non-clashing ones (",{"italic":2765},[2766],{"#text":1745},{"#text":2768},"'s \u003C 0.0001). Secondly, there were significant interactions between Item Rating and both the listener's political views and their disgust sensitivity (",{"italic":2770},[2771],{"#text":1745},{"#text":2773},"'s \u003C 0.0001) that further interacted with time (",{"italic":2775},[2776],{"#text":1745},{"#text":2778},"'s \u003C 0.0001). As ",{"xref":2780,":@":2782},[2781],{"#text":2677},{"@_ref-type":2659,"@_rid":2660},{"#text":2784}," shows, in both cases, it was listeners with high scores on the respective questionnaires, that is, more conservative-leaning and more disgust-sensitive listeners, respectively, who experienced a larger increase in pupil dilation in response to a socio-cultural violation.",{"#text":887},{"#text":890},{"@_sec-type":2788,"@_id":2789},"results","s3",{"#text":890},{"sec":2792,":@":3120,"anchorId":3122},[2793,2794,2798,2799,2826,2827,2896,2897,2953,2954,2958,2959,2969,2970,3016,3017,3108,3109,3119],{"#text":887},{"title":2795},[2796],{"#text":2797},"4. Discussion",{"#text":887},{"p":2800},[2801,2803,2807,2809,2813,2815,2819,2820,2824],{"#text":2802},"Prior research suggests that individual's moral views (Van Berkum et al., ",{"xref":2804,":@":2806},[2805],{"#text":915},{"@_ref-type":908,"@_rid":1276},{"#text":2808},") as well as aspects of personality (Van den Brink et al., ",{"xref":2810,":@":2812},[2811],{"#text":1046},{"@_ref-type":908,"@_rid":1048},{"#text":2814},"; Hubert Lyall, ",{"xref":2816,":@":2818},[2817],{"#text":1022},{"@_ref-type":908,"@_rid":2157},{"#text":1050},{"xref":2821,":@":2823},[2822],{"#text":1054},{"@_ref-type":908,"@_rid":1056},{"#text":2825},") predict online spoken language comprehension times. In this research, we asked whether and to what extent person's sensitivity to disgust and their political ideology affect the processing of spoken utterances with different types of violations/clashes.",{"#text":887},{"p":2828},[2829,2831,2835,2836,2840,2841,2845,2846,2850,2851,2855,2856,2860,2861,2865,2866,2870,2872,2876,2878,2882,2884,2888,2890,2894],{"#text":2830},"We found a significant effect of item rating—the extent to which a statement was grammatically, semantically, or pragmatically anomalous—for all three violation types. In all cases, listeners showed a significant pupil dilation in the clashing condition as compared to baseline, reflecting an increased processing cost as indicated by increased pupil dilation (Hess and Polt, ",{"xref":2832,":@":2834},[2833],{"#text":1402},{"@_ref-type":908,"@_rid":1404},{"#text":1246},{"xref":2837,":@":2839},[2838],{"#text":1409},{"@_ref-type":908,"@_rid":1411},{"#text":1413},{"xref":2842,":@":2844},[2843],{"#text":1417},{"@_ref-type":908,"@_rid":1419},{"#text":1421},{"xref":2847,":@":2849},[2848],{"#text":1425},{"@_ref-type":908,"@_rid":1427},{"#text":1429},{"xref":2852,":@":2854},[2853],{"#text":1433},{"@_ref-type":908,"@_rid":1435},{"#text":1437},{"xref":2857,":@":2859},[2858],{"#text":1046},{"@_ref-type":908,"@_rid":1442},{"#text":1384},{"xref":2862,":@":2864},[2863],{"#text":1199},{"@_ref-type":908,"@_rid":1389},{"#text":1449},{"xref":2867,":@":2869},[2868],{"#text":1088},{"@_ref-type":908,"@_rid":1454},{"#text":2871},"). Importantly, listeners' conservatism and disgust sensitivity scores interacted with item rating: More disgust-sensitive and conservative individuals allocated more resources to the processing of socio-cultural violations, suggesting that an individual's disgust sensitivity modulated their allocation of cognitive resources for understanding the pragmatic implications of the message. This result extends the findings from, for example, Schaller and Neuberg (",{"xref":2873,":@":2875},[2874],{"#text":1046},{"@_ref-type":908,"@_rid":1076},{"#text":2877},"); Murray and Schaller (",{"xref":2879,":@":2881},[2880],{"#text":931},{"@_ref-type":908,"@_rid":1117},{"#text":2883},"); Aarøe et al. (",{"xref":2885,":@":2887},[2886],{"#text":1014},{"@_ref-type":908,"@_rid":1155},{"#text":2889},"); Wagemans et al. (",{"xref":2891,":@":2893},[2892],{"#text":1088},{"@_ref-type":908,"@_rid":1090},{"#text":2895},") to the realm of real-time language comprehension, suggesting that the behavioral immune system influences an individual's response to a statement as soon as the statement is being processed.",{"#text":887},{"p":2898},[2899,2901,2905,2907,2911,2912,2916,2917,2921,2922,2926,2927,2931,2932,2936,2937,2941,2942,2946,2947,2951],{"#text":2900},"While prior research has found that more disgust-sensitive individuals generally tend to be more conservative (Faulkner et al., ",{"xref":2902,":@":2904},[2903],{"#text":980},{"@_ref-type":908,"@_rid":1174},{"#text":2906},"; Graham et al., ",{"xref":2908,":@":2910},[2909],{"#text":915},{"@_ref-type":908,"@_rid":2345},{"#text":1176},{"xref":2913,":@":2915},[2914],{"#text":915},{"@_ref-type":908,"@_rid":1181},{"#text":1246},{"xref":2918,":@":2920},[2919],{"#text":1046},{"@_ref-type":908,"@_rid":2269},{"#text":1183},{"xref":2923,":@":2925},[2924],{"#text":1067},{"@_ref-type":908,"@_rid":1188},{"#text":1071},{"xref":2928,":@":2930},[2929],{"#text":1046},{"@_ref-type":908,"@_rid":1076},{"#text":1195},{"xref":2933,":@":2935},[2934],{"#text":1199},{"@_ref-type":908,"@_rid":1201},{"#text":1112},{"xref":2938,":@":2940},[2939],{"#text":931},{"@_ref-type":908,"@_rid":1117},{"#text":1208},{"xref":2943,":@":2945},[2944],{"#text":931},{"@_ref-type":908,"@_rid":1213},{"#text":1150},{"xref":2948,":@":2950},[2949],{"#text":1014},{"@_ref-type":908,"@_rid":1155},{"#text":2952},"), the two variables were not strongly correlated in our participant sample; instead, we observed only a weak, non-significant correlation. This suggests that, even though the two variables may occasionally be correlated, their influence on real-time language comprehension may be distinct.",{"#text":887},{"p":2955},[2956],{"#text":2957},"Further, with the proviso that pupillometry is not the best method to track precise processing time course, our results do suggest that the effect of the listener's political views had a later onset than that of disgust sensitivity. Thus, disgust sensitivity may affect processing earlier, perhaps affecting anticipation or immediate integration into the context.",{"#text":887},{"p":2960},[2961,2963,2967],{"#text":2962},"We observed an interesting result in the processing of semantic anomalies. While more disgust-sensitive listeners experienced increased pupil dilation shortly after a semantically anomalous word, it was ",{"italic":2964},[2965],{"#text":2966},"less",{"#text":2968}," conservative listeners that experienced greater resource allocation to a semantically anomalous stimulus.",{"#text":887},{"p":2971},[2972,2974,2979,2981,2987,2989,2994,2995,2999,3001,3007,3009,3014],{"#text":2973},"The late onset of the effect in progressive listeners is in line with and could be analogous to the late posterior positivity/P600 reported in Kuperberg et al. (",{"xref":2975,":@":2977},[2976],{"#text":1030},{"@_ref-type":908,"@_rid":2978},"B57",{"#text":2980},"), reflecting an initial failure to integrate the anomalous utterance into the existing situation model. In this scenario, even though progressive listeners are initially not affected by the anomalous expression, they experience increased processing load at a later, integration, stage. The late posterior positivity/P600 component is also often found in response to unexpected syntactic structures, animacy violations, or semantically anomalous words, sometimes reflecting late, coherence establishing processes (Osterhout and Holcomb, ",{"xref":2982,":@":2985},[2983],{"#text":2984},"1992",{"@_ref-type":908,"@_rid":2986},"B74",{"#text":2988},"; Kuperberg et al., ",{"xref":2990,":@":2992},[2991],{"#text":999},{"@_ref-type":908,"@_rid":2993},"B58",{"#text":1246},{"xref":2996,":@":2998},[2997],{"#text":1030},{"@_ref-type":908,"@_rid":2978},{"#text":3000},"). While the component generally peaks between 500 and 800 ms after stimulus onset, some prior research (see, for example, Kim and Osterhout, ",{"xref":3002,":@":3005},[3003],{"#text":3004},"2005",{"@_ref-type":908,"@_rid":3006},"B55",{"#text":3008},"; Nieuwland and Van Berkum, ",{"xref":3010,":@":3012},[3011],{"#text":3004},{"@_ref-type":908,"@_rid":3013},"B70",{"#text":3015},") has found later peaking, around 900 to 1,000 ms after stimulus onset. Given the make-up of our stimuli, this effect would coincide time-wise with the end of the experimental utterance and so with late integration.",{"#text":887},{"p":3018},[3019,3021,3025,3027,3031,3032,3036,3038,3043,3045,3050,3052,3057,3059,3063,3064,3068,3070,3075,3077,3081,3083,3087,3089,3093,3095,3100,3102,3107],{"#text":3020},"Finally, while we found a pupil response to all three types of deviations from the norm, only the processing of semantic anomalies and socio-cultural clashes was affected by participants' political ideology and disgust sensitivity. This suggests that there may have been an emotional component to our results. Pupillometry has been shown to be sensitive to effects stemming from both increased processing load as well as from affective demands (Beatty, ",{"xref":3022,":@":3024},[3023],{"#text":1846},{"@_ref-type":908,"@_rid":1848},{"#text":3026},"; Steinhauer et al., ",{"xref":3028,":@":3030},[3029],{"#text":980},{"@_ref-type":908,"@_rid":1382},{"#text":1384},{"xref":3033,":@":3035},[3034],{"#text":1199},{"@_ref-type":908,"@_rid":1389},{"#text":3037},"). Research has shown that language processing is affected by mood, and happy and sad mood might engage different neural networks (Egidi and Gerrig, ",{"xref":3039,":@":3041},[3040],{"#text":915},{"@_ref-type":908,"@_rid":3042},"B20",{"#text":3044},"; Egidi and Nusbaum, ",{"xref":3046,":@":3048},[3047],{"#text":1046},{"@_ref-type":908,"@_rid":3049},"B21",{"#text":3051},"; Egidi and Caramazza, ",{"xref":3053,":@":3055},[3054],{"#text":923},{"@_ref-type":908,"@_rid":3056},"B19",{"#text":3058},"). Moreover, statements conflicting with an individual's values have been shown to quickly engage the affect system and modulate language comprehension (Van Berkum et al., ",{"xref":3060,":@":3062},[3061],{"#text":1038},{"@_ref-type":908,"@_rid":1040},{"#text":1246},{"xref":3065,":@":3067},[3066],{"#text":915},{"@_ref-type":908,"@_rid":1276},{"#text":3069},"). Relatedly, Van Berkum et al. (",{"xref":3071,":@":3073},[3072],{"#text":2131},{"@_ref-type":908,"@_rid":3074},"B100",{"#text":3076},") showed that individuals' mood affects the extent to which they engage in predictive processing during language comprehension. However, this does not seem to be the case across-the-board: they found no effect of mood for agreement violations, only for the violations of expectations as prompted by utterances depicting interpersonal events with social causes and consequences. Since both political views and disgust sensitivity have been linked to personality traits (Haidt et al., ",{"xref":3078,":@":3080},[3079],{"#text":2248},{"@_ref-type":908,"@_rid":2250},{"#text":3082},"; Druschel and Sherman, ",{"xref":3084,":@":3086},[3085],{"#text":906},{"@_ref-type":908,"@_rid":1167},{"#text":3088},") that themselves affect the processing of spoken statements (Hubert Lyall and Järvikivi, ",{"xref":3090,":@":3092},[3091],{"#text":1054},{"@_ref-type":908,"@_rid":1056},{"#text":3094},"), it may be that, at least partly, these effects stem from the same underlying emotional response (van Berkum, ",{"xref":3096,":@":3098},[3097],{"#text":1030},{"@_ref-type":908,"@_rid":3099},"B99",{"#text":3101},"; Wheeler et al., ",{"xref":3103,":@":3105},[3104],{"#text":1030},{"@_ref-type":908,"@_rid":3106},"B108",{"#text":1157},{"#text":887},{"p":3110},[3111,3113,3117],{"#text":3112},"In summary, our study is the first to show that an individual's disgust sensitivity, the emotional signature of the Behavioral Immune System, along with the individual's political views, modulate the resources allocated to the comprehension of an auditory linguistic message. Individuals' politically leaning toward conservatism showed more resource allocation to socio-cultural violations, which aligns with prior literature suggesting that this group is more prone to elevated Behavioral Immune System activity, and out-group stigmatization (see Hodson and Dhont, ",{"xref":3114,":@":3116},[3115],{"#text":1199},{"@_ref-type":908,"@_rid":1201},{"#text":3118},", for an overview). Specifically, our results are the first to show that the effects of disgust sensitivity on the comprehension of a deviating statement, via the immediate inference of vocal gender and linguistic meaning, are immediate and automatic. Our results further highlight that individual difference variables do not affect language comprehension wholesale, across the board; but that these variables interact with the type of clash being processed. The results thus support theories of language comprehension that assign importance to extra-linguistic context, consisting not only of linguistics context proper but also of individual's knowledge and conceptions of the world, and in which this extra-linguistic context influences real-time language comprehension early on. Our results further suggest that both an individual's experience with the world as well as (related) aspects of their personality may shape their real-time language processing.",{"#text":890},{"@_sec-type":3121,"@_id":3122},"discussion","s4",{"#text":890},{"sec":3125,":@":3137},[3126,3127,3131,3132,3136],{"#text":887},{"title":3128},[3129],{"#text":3130},"Data Availability Statement",{"#text":887},{"p":3133},[3134],{"#text":3135},"The raw data supporting the conclusions of this article will be made available by the authors, without undue reservation.",{"#text":890},{"@_sec-type":3138,"@_id":3139},"data-availability","s5",{"#text":890},{"sec":3142,":@":3154},[3143,3144,3148,3149,3153],{"#text":887},{"title":3145},[3146],{"#text":3147},"Ethics Statement",{"#text":887},{"p":3150},[3151],{"#text":3152},"The studies involving human participants were reviewed and approved by Research Ethics Board 2 at the University of Alberta. The patients/participants provided their written informed consent to participate in this study.",{"#text":890},{"@_id":3155},"s6",{"#text":890},{"sec":3158,":@":3170},[3159,3160,3164,3165,3169],{"#text":887},{"title":3161},[3162],{"#text":3163},"Author Contributions",{"#text":887},{"p":3166},[3167],{"#text":3168},"IH and JJ jointly conceived and designed the experiments and contributed to the writing of the manuscript. IH analyzed the data, wrote the first full draft, and performed the experiments with the assistance of undergraduate assistants. All authors contributed to the article and approved the submitted version.",{"#text":890},{"@_id":3171},"s7",{"#text":890},{"sec":3174,":@":3193,"anchorId":3195},[3175,3176,3180,3181,3192],{"#text":887},{"title":3177},[3178],{"#text":3179},"Funding",{"#text":887},{"p":3182},[3183,3185,3190],{"#text":3184},"This research was supported by a Social Sciences and Humanities Research Council of Canada (",{"ext-link":3186,":@":3189},[3187],{"#text":3188},"http://www.sshrc-crsh.gc.ca/",{"@_ext-link-type":853,"@_xlink:href":3188},{"#text":3191},") Partnership Grant (Words in the World, 895-2016-1008).",{"#text":890},{"@_sec-type":3194,"@_id":3195},"funding-information","s8",{"#text":890},{"sec":3198,":@":3210},[3199,3200,3204,3205,3209],{"#text":887},{"title":3201},[3202],{"#text":3203},"Conflict of Interest",{"#text":887},{"p":3206},[3207],{"#text":3208},"The authors declare that the research was conducted in the absence