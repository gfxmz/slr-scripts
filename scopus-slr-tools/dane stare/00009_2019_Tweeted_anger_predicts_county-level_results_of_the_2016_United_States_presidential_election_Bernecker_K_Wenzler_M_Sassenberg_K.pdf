,{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.001\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"78.80\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\".780\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"\u003c0.001\"}]]}],[\"$\",\"tr\",\"8\",{\"children\":[\"$\",\"td\",null,{\"valign\":\"top\",\"align\":\"left\",\"colSpan\":\"7\",\"children\":\"Twitter language\"}]}],[\"$\",\"tr\",\"10\",{\"children\":[\"$\",\"td\",null,{\"valign\":\"top\",\"align\":\"left\",\"colSpan\":\"7\",\"children\":\"    Emotional\"}]}],[\"$\",\"tr\",\"12\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"      Anger\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.011\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.002\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.002\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"5.35\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\".071\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"\u003c.001\"}]]}],[\"$\",\"tr\",\"14\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"      Anxiety\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.001\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.001\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–1.20\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–.010\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\".229\"}]]}],[\"$\",\"tr\",\"16\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"      Negative emotions\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.005\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.002\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.002\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"3.08\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\".034\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\".002\"}]]}],[\"$\",\"tr\",\"18\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"      Positive emotions\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.002\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.002\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"1.36\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\".015\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\".175\"}]]}],[\"$\",\"tr\",\"20\",{\"children\":[\"$\",\"td\",null,{\"valign\":\"top\",\"align\":\"left\",\"colSpan\":\"7\",\"children\":\"    Cognitive\"}]}],[\"$\",\"tr\",\"22\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"      Engagement\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.010\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.006\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.001\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–6.95\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–.067\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"\u003c.001\"}]]}],[\"$\",\"tr\",\"24\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"      Disengagement\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.006\"}],\"$L11c\",\"$L11d\",\"$L11e\",\"$L11f\",\"$L120\"]}],\"$L121\",\"$L122\",\"$L123\",\"$L124\",\"$L125\",\"$L126\",\"$L127\",\"$L128\",\"$L129\",\"$L12a\",\"$L12b\"]}]}]}],\"\\n\",\"$L12c\",\"\\n\"]}]}]\ndf:[\"$\",\"p\",\"9\",{\"children\":\"Despite having controlled for previous election results and various county characteristics, four out of six Twitter language parameters significantly predicted county-level vote choice for Donald Trump. In line with our hypothesis, Donald Trump received relatively more votes in counties where people twittered more anger and negative emotions. Anxiety and positive emotions on the other hand did not predict vote choice. These results suggest that Trump attracted voters in counties where people were more likely to express anger and negative emotions, but not in counties where voters tweeted words signaling anxiety or positive emotions.\"}]\ne0:[\"$\",\"p\",\"11\",{\"children\":[\"Results further show that in counties where people used more language signaling cognitive engagement, Donald Trump received fewer votes under consideration of the results of his forerunner. However, he also received fewer votes in counties where people used language signaling cognitive \",[\"$\",\"em\",\"1\",{\"children\":\"dis\"}],\"engagement. This result might be considered as surprising given that the results of the partial correlations in Table \",[\"$\",\"span\",\"3\",{\"className\":\"xref\",\"children\":[\"$\",\"$L20\",null,{\"href\":\"#T1\",\"ref\":\"$undefined\",\"children\":\"1\"}]}],\" show that cognitive disengagement was overall \",[\"$\",\"em\",\"5\",{\"children\":\"positively\"}],\" related to conservative voting behavior in both presidential elections. Thus, this relationship should be considered with caution given that that the sign of the effect reverses between partial correlation and the multiple regression model.\"]}]\ne1:[\"$\",\"p\",\"13\",{\"children\":\"Next, we examined whether Twitter language parameters should be included in the most parsimonious model predicting the election results. Therefore, we applied an elastic net regression to our set of 14 predictors and used 10-fold cross-validation to derive at the model’s regularization parameters (λ = 0.00028, α = 0.55). Results showed that the most parsimonious model to predict the results of the election did not include anxiety, positive emotions, and cognitive disengagement. Among the county characteristics the percentage of female population was dropped as predictor. The fact that anger, negative emotions, and cognitive engagement were kept as predictors indicates that they independently contribute to the prediction of the election results despite of their high intercorrelation (see Table S1 in the additional files).\"}]\ne2:[\"$\",\"p\",\"15\",{\"children\":[\"As a last step, we ran a 10-fold cross-validation regression model including only anger, negative emotions, and cognitive engagement to estimate how much of the variance in the election results of 2016 can be explained by these three predictors alone. Results showed that a model trained on these Twitter language parameters alone on average predicted 8% of the variance in the election results (\",[\"$\",\"em\",\"1\",{\"children\":[\"M\",[\"$\",\"sub\",\"1\",{\"children\":\"R\"}]]}],[\"$\",\"sub\",\"2\",{\"children\":\"²\"}],\" = 0.079, \",[\"$\",\"em\",\"4\",{\"children\":[\"SD\",[\"$\",\"sub\",\"1\",{\"children\":\"R\"}]]}],[\"$\",\"sub\",\"5\",{\"children\":\"²\"}],\" = 0.028, \",[\"$\",\"em\",\"7\",{\"children\":[\"M\",[\"$\",\"sub\",\"1\",{\"children\":\"RMSE\"}]]}],\"= 0.147, \",[\"$\",\"em\",\"9\",{\"children\":[\"SD\",[\"$\",\"sub\",\"1\",{\"children\":\"RMSE\"}]]}],\" = 0.003), which is according to Cohen (\",[\"$\",\"span\",\"11\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B14\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B14\",\"data-scroll\":\"#B14\",\"rel\":\"footnote\",\"id\":\"main-text-B14\",\"className\":\"scroll-link\"},\"children\":\"1988\"}]}]}],\") a medium-sized effect.\"]}]\ne3:[\"$\",\"th\",\"25\",{\"align\":\"center\",\"children\":[\"$\",\"em\",null,{\"children\":\"(SD)\"}]}]\ne4:[\"$\",\"th\",\"27\",{\"align\":\"center\",\"children\":[\"$\",\"em\",null,{\"children\":\"d\"}]}]\ne5:[\"$\",\"th\",\"29\",{\"align\":\"center\",\"children\":[\"$\",\"em\",null,{\"children\":\"M\"}]}]\ne6:[\"$\",\"th\",\"31\",{\"align\":\"center\",\"children\":[\"$\",\"em\",null,{\"children\":\"(SD)\"}]}]\ne7:[\"$\",\"th\",\"33\",{\"align\":\"center\",\"children\":[\"$\",\"em\",null,{\"children\":\"d\"}]}]\ne8:[\"$\",\"th\",\"35\",{\"align\":\"center\",\"children\":[\"$\",\"em\",null,{\"children\":[\"d\",[\"$\",\"sub\",\"1\",{\"children\":\"speech\"}]]}]}]\ne9:[\"$\",\"tr\",\"10\",{\"children\":[\"$\",\"td\",null,{\"valign\":\"top\",\"colSpan\":\"18\",\"children\":[\"$\",\"hr\",null,{\"children\":\"$undefined\"}]}]}]\nea:[\"$\",\"tr\",\"12\",{\"children\":[\"$\",\"td\",null,{\"valign\":\"top\",\"align\":\"left\",\"colSpan\":\"18\",\"children\":\"Emotional\"}]}]\neb:[\"$\",\"tr\",\"14\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"    Anger\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.52\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(1.70)\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.59\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(1.83)\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.04\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.85\"}],[\"$\",\"td\",\"15\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.37)\"}],[\"$\",\"td\",\"17\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.48\"}],[\"$\",\"td\",\"19\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.31)\"}],[\"$\",\"td\",\"21\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"1.05\"}],[\"$\",\"td\",\"23\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.40\"}],[\"$\",\"td\",\"25\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.40)\"}],[\"$\",\"td\",\"27\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"1.16\"}],[\"$\",\"td\",\"29\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.47\"}],[\"$\",\"td\",\"31\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.19)\"}],[\"$\",\"td\",\"33\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"1.35\"}],[\"$\",\"td\",\"35\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"1.23\"}]]}]\nec:[\"$\",\"tr\",\"16\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"    Anxiety\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.22\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(1.04)\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.22\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(1.70)\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.00\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.30\"}],[\"$\",\"td\",\"15\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.22)\"}],[\"$\",\"td\",\"17\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.24\"}],[\"$\",\"td\",\"19\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.18)\"}],[\"$\",\"td\",\"21\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.30\"}],[\"$\",\"td\",\"23\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.19\"}],[\"$\",\"td\",\"25\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.21)\"}],[\"$\",\"td\",\"27\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.49\"}],[\"$\",\"td\",\"29\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.08\"}],[\"$\",\"td\",\"31\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.08)\"}],[\"$\",\"td\",\"33\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"1.37\"}],[\"$\",\"td\",\"35\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.76\"}]]}]\ned:[\"$\",\"tr\",\"18\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"    Negative\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.24\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(1.12)\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.14\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.83)\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.11\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.18\"}],[\"$\",\"td\",\"15\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.10)\"}],[\"$\",\"td\",\"17\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.14\"}],[\"$\",\"td\",\"19\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.09)\"}],[\"$\",\"td\",\"21\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.45\"}],[\"$\",\"td\",\"23\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.14\"}],[\"$\",\"td\",\"25\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.16)\"}],[\"$\",\"td\",\"27\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.35\"}],[\"$\",\"td\",\"29\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.05\"}],[\"$\",\"td\",\"31\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.04)\"}],[\"$\",\"td\",\"33\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"1.79\"}],[\"$\",\"td\",\"35\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.71\"}]]}]\nee:[\"$\",\"tr\",\"20\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"    Positive\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"1.17\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(2.96)\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.28\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(1.29)\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.41\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.40\"}],[\"$\",\"td\",\"15\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.32)\"}],[\"$\",\"td\",\"17\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.41\"}],[\"$\",\"td\",\"19\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.17)\"}],[\"$\",\"td\",\"21\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.02\"}],[\"$\",\"td\",\"23\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.32\"}],[\"$\",\"td\",\"25\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.18)\"}],[\"$\",\"td\",\"27\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.33\"}],[\"$\",\"td\",\"29\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.24\"}],[\"$\",\"td\",\"31\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.16)\"}],[\"$\",\"td\",\"33\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.68\"}],[\"$\",\"td\",\"35\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.44\"}]]}]\nef:[\"$\",\"tr\",\"22\",{\"children\":[\"$\",\"td\",null,{\"valign\":\"top\",\"align\":\"left\",\"colSpan\":\"18\",\"children\":\"Cognitive\"}]}]\nf0:[\"$\",\"tr\",\"24\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"    Engage\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.08\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.69)\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.10\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.72)\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.03\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.12\"}],[\"$\",\"td\",\"15\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.13)\"}],[\"$\",\"td\",\"17\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.16\"}],[\"$\",\"td\",\"19\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.11)\"}],[\"$\",\"td\",\"21\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.42\"}],[\"$\",\"td\",\"23\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.16\"}],[\"$\",\"td\",\"25\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.13)\"}],[\"$\",\"td\",\"27\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.36\"}],[\"$\",\"td\",\"29\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.10\"}],[\"$\",\"td\",\"31\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.08)\"}],[\"$\",\"td\",\"33\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.13\"}],[\"$\",\"td\",\"35\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"–0.20\"}]]}]\nf1:[\"$\",\"tr\",\"26\",{\"children\":[[\"$\",\"td\",\"1\",{\"valign\":\"top\",\"align\":\"left\",\"children\":\"    Disengage\"}],[\"$\",\"td\",\"3\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.03\"}],[\"$\",\"td\",\"5\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.39)\"}],[\"$\",\"td\",\"7\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.01\"}],[\"$\",\"td\",\"9\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.15)\"}],[\"$\",\"td\",\"11\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.09\"}],[\"$\",\"td\",\"13\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.05\"}],[\"$\",\"td\",\"15\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.05)\"}],[\"$\",\"td\",\"17\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.02\"}],[\"$\",\"td\",\"19\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.03)\"}],[\"$\",\"td\",\"21\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.79\"}],[\"$\",\"td\",\"23\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.03\"}],[\"$\",\"td\",\"25\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.05)\"}],[\"$\",\"td\",\"27\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.42\"}],[\"$\",\"td\",\"29\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.02\"}],[\"$\",\"td\",\"31\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"(0.03)\"}],[\"$\",\"td\",\"33\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.82\"}],[\"$\",\"td\",\"35\",{\"valign\":\"top\",\"align\":\"right\",\"children\":\"0.67\"}]]}]\nf2:[\"$\",\"div\",\"5\",{\"className\":\"caption\",\"children\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"em\",\"0\",{\"children\":[\"Note: d\",[\"$\",\"sub\",\"1\",{\"children\":\"tweets\"}]]}],\" = Cohen’s \",[\"$\",\"em\",\"2\",{\"children\":\"d\"}],\" for the comparison of pre-election tweets of Donald Trump and Hillary Clinton; \",[\"$\",\"em\",\"4\",{\"children\":[\"d\",[\"$\",\"sub\",\"1\",{\"children\":\"speech\"}]]}],\" = Averaged effect size for the comparisons between campaign speeches of Donald Trump with campaign speeches of Hillary Clinton, Mitt Romney, and Barack Obama.\"]}]}]\nf3:[\"$\",\"p\",\"7\",{\"children\":[\"Last, we compared Donald Trump’s campaign speeches to those of Hillary Clinton, Mitt Romney, and Barack Obama. For the sake of readability, we will interpret the averaged effect size comparing Trump’s campaign to the other campaigns of the other presidential candidates in 2016 and 2012 (\",[\"$\",\"em\",\"1\",{\"children\":[\"d\",[\"$\",\"sub\",\"1\",{\"children\":\"speech\"}]]}],\" in Table \",[\"$\",\"span\",\"3\",{\"className\":\"xref\",\"children\":[\"$\",\"$L20\",null,{\"href\":\"#T3\",\"ref\":\"$undefined\",\"children\":\"3\"}]}],\"). As expected, Donald Trump expressed consistently more anger and negative emotions in his campaign speeches than Hillary Clinton, Mitt Romney, and Barack Obama. Both averaged effect sizes were large in size with 81% and 69% probability of superiority. With regard to anxiety there was a difference with Trump expressing more anxiety-related words in his speeches (70% probability of superiority); however, this difference was mainly driven by Obama’s campaign speeches in 2012, which had very low instances of anxiety-related words (\",[\"$\",\"em\",\"5\",{\"children\":[\"d\",[\"$\",\"sub\",\"1\",{\"children\":\"speech\"}]]}],\" reduces to 0.43 and 62% probability of superiority when not considering Obama’s campaign speeches). Further, there was a small difference in speeches with regard to positive emotion words with 62% probability of superiority for Trump’s campaign speeches (reduced to 0.21 and 55% when not considering Obama’s campaign speeches).\"]}]\nf4:[\"$\",\"p\",\"9\",{\"children\":[\"We also explored whether speeches differed with regard to language signaling cognitive (dis-)engagement. However, there was only a small effect size with regard to Trump using fewer words signaling cognitive engagement (56% probability of superiority). Again, the campaign speeches of Barack Obama stood out in this regard, because Hillary Clinton and Mitt Romney both used considerably more language signaling cognitive engagement than Donald Trump (\",[\"$\",\"em\",\"1\",{\"children\":[\"d\",[\"$\",\"sub\",\"1\",{\"children\":\"speech\"}]]}],\" increases to –0.32 and 59% probability of superiority when not considering Obama’s campaign speeches). However, Donald Trump used consistently more words signaling cognitive disengagement with a 68% probability of superiority.\"]}]\nf5:[\"$\",\"p\",\"11\",{\"children\":\"In sum, these results suggest that the expression of anger and negative emotions was characteristic for Trump’s campaign speeches and supports the idea that emotional resonance may explain why the expression of these emotions on social media predicted vote choice for Donald Trump on the county level.\"}]\nf7:[\"$\",\"span\",\"1\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B56\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B56\",\"data-scroll\":\"#B56\",\"rel\":\"footnote\",\"id\":\"main-text-B56\",\"className\":\"scroll-link\"},\"children\":\"Roseman et al., 1986\"}]}]}]\nf8:[\"$\",\"span\",\"3\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B31\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B31\",\"data-scroll\":\"#B31\",\"rel\":\"footnote\",\"id\":\"main-text-B31\",\"className\":\"scroll-link\"},\"children\":\"Hoffman \u0026 Stawski, 2009\"}]}]}]\nf9:[\"$\",\"span\",\"5\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B22\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B22\",\"data-scroll\":\"#B22\",\"rel\":\"footnote\",\"id\":\"main-text-B22\",\"className\":\"scroll-link\"},\"children\":\"Freedman, 1999\"}]}]}]\nfa:[\"$\",\"span\",\"7\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B47\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B47\",\"data-scroll\":\"#B47\",\"rel\":\"footnote\",\"id\":\"main-text-B47\",\"className\":\"scroll-link\"},\"children\":\"Na et al., 2010\"}]}]}]\nfb:[\"$\",\"p\",\"7\",{\"children\":[\"The long time span covered by our data comes with the advantage that previous elections can be controlled for, which makes a stronger case for the particular role of negative emotions in the 2016 election. Two out of four emotional language variables predicted vote choice in the 2016 election, while none of them predicted vote choice in 2012. This result is particularly surprising given that Twitter data was sampled in 2010 and therefore closer to the 2012 election. If anything, one would have expected that Twitter data should be a \",[\"$\",\"em\",\"1\",{\"children\":\"stronger\"}],\" predictor in the 2012 election. Further, the long interval between measurement of emotions and election outcomes suggests that effects sizes are likely to be underestimated due to increases in error variance (e.g., people change or move to other counties).\"]}]\n12d:T481,)” (p. 166). A local event like, for instance, the dismissal of a significant amount of employees by an enterprise might elicit anger or other negative emotions. Such events might continuously affect people’s emotions, because of family members’ longer lasting unemployment or because of empty buildings reminding of the event. The fact that emotions predicted the election outcome over and above socioeconomic status and demographic variables does not necessarily contradict the idea that the part of the stable variance in anger that predicted Trump votes was an expression of stable life dissatisfaction or political discontent. For instance, perceived or expected threats (e.g., loss of privileges relative to outgroups) or stress might cause negative emotions independent of the objective developments of people’s actual life circumstances. As already mentioned, the data of the present study can unfortunately not speak to the question what causes regional differences in the expression of anger and negative emotions on social media. However, we and others could show that they might be useful to predict important county-level outcomes (fc:[\"$\",\"p\",\"9\",{\"children\":[\"An open question that cannot be addressed by the present study is what caused the stable differences in anger and negative emotions that predicted election outcomes. Based on previous research, showing regional differences in traits across the U.S. (\",[\"$\",\"span\",\"1\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B55\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B55\",\"data-scroll\":\"#B55\",\"rel\":\"footnote\",\"id\":\"main-text-B55\",\"className\":\"scroll-link\"},\"children\":\"Rentfrow, 2010\"}]}]}],\"), we can only speculate that these emotions might reflect regional differences in trait anger and negative affectivity mainly driven by local culture. Another possible explanation would be that anger and negative emotions reflected stable regional differences in (political) discontent or life dissatisfaction present already in 2010. Research suggests that life satisfaction is relatively stable over longer period of times and differs not only between individuals but also between U.S. counties (\",[\"$\",\"span\",\"3\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B18\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B18\",\"data-scroll\":\"#B18\",\"rel\":\"footnote\",\"id\":\"main-text-B18\",\"className\":\"scroll-link\"},\"children\":\"Eid \u0026 Diener, 2004\"}]}]}],\"; \",[\"$\",\"span\",\"5\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B24\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B24\",\"data-scroll\":\"#B24\",\"rel\":\"footnote\",\"id\":\"main-text-B24\",\"className\":\"scroll-link\"},\"children\":\"Fujita \u0026 Diener, 2005\"}]}]}],\"; \",[\"$\",\"span\",\"7\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B40\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B40\",\"data-scroll\":\"#B40\",\"rel\":\"footnote\",\"id\":\"main-text-B40\",\"className\":\"scroll-link\"},\"children\":\"Lucas \u0026 Donnellan, 2007\"}]}]}],\"; \",[\"$\",\"span\",\"9\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B60\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B60\",\"data-scroll\":\"#B60\",\"rel\":\"footnote\",\"id\":\"main-text-B60\",\"className\":\"scroll-link\"},\"children\":\"Schwartz et al., 2013\"}]}]}],\"). As argued by Eichstaedt et al. (\",[\"$\",\"span\",\"11\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B17\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B17\",\"data-scroll\":\"#B17\",\"rel\":\"footnote\",\"id\":\"main-text-B17\",\"className\":\"scroll-link\"},\"children\":\"2015\"}]}]}],\"), “local communities create physical and social environments that influence the behaviors, stress experiences, and health of their residents (\",[\"$\",\"span\",\"13\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B16\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B16\",\"data-scroll\":\"#B16\",\"rel\":\"footnote\",\"id\":\"main-text-B16\",\"className\":\"scroll-link\"},\"children\":\"Diez Roux \u0026 Mair, 2009\"}]}]}],\"; \",[\"$\",\"span\",\"15\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B39\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B39\",\"data-scroll\":\"#B39\",\"rel\":\"footnote\",\"id\":\"main-text-B39\",\"className\":\"scroll-link\"},\"children\":\"Lochner, Kawachia, Brennan, \u0026 Bukac, 2003\"}]}]}],\"$12d\",\"$L12e\",\").\"]}]\nfd:[\"$\",\"p\",\"7\",{\"children\":[\"Last, although the sample of tweets was randomly selected among the population of tweets available, it may still not be representative of the general population of the U.S. (\",[\"$\",\"span\",\"1\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B17\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B17\",\"data-scroll\":\"#B17\",\"rel\":\"footnote\",\"id\":\"main-text-B17\",\"className\":\"scroll-link\"},\"children\":\"Eichstaedt et al., 2015\"}]}]}],\"). Research shows that the Twitter population tends to live in urban areas and to have above-average levels of education (\",[\"$\",\"span\",\"3\",{\"className\":\"xref\",\"children\":[\"$\",\"strong\",null,{\"children\":[\"$\",\"$L54\",null,{\"scrollId\":\"B45\",\"linkProps\":{\"class\":\"$undefined\",\"href\":\"#B45\",\"data-scroll\":\"#B45\",\"rel\":\"footnote\",\"id\":\"main-text-B45\",\"className\":\"scroll-link\"},\"children\":\"Mislove, Lehmann, Ahn, Onnela, \u0026 Rosenquist, 2011\"}]}]}],\"). Results may therefore overly reflect relationships for the urban and well-educated part of the population and, therefore, may not generalize to the U.S. population as a whole.\"]}]\nfe:[\"$\",\"meta\",\"23\",{\"name\":\"DC.Source.source\",\"content\":\"https://rips-irsp.com//articles/10.5334/irsp.256\"}]\nff:[\"$\",\"meta\",\"24\",{\"name\":\"DC.Title.title\",\"content\":\"Tweeted Anger Predicts County-Level Results of the 2016 United States Presidential Election\"}]\n100:[\"$\",\"meta\",\"25\",{\"name\":\"DC.Type.type\",\"content\":\"Text\"}]\n101:[\"$\",\"meta\",\"26\",{\"name\":\"DC.Rights.rights\",\"content\":\"© 2019 The Author(s). This is an Open Access article distributed under the terms of the Creative Commons Attribution 4.0 license (unless stated otherwise) which permits unrestricted use, distribution, and reproduction in any medium, provided the original work is properly cited.\"}]\n102:[\"$\",\"meta\",\"27\",{\"name\":\"DC.Rights.license\",\"content\":\"CC BY 4.0\"}]\n103:[\"$\",\"meta\",\"28\",{\"name\":\"DC.rightsHolder\",\"content\":\"The Author(s)\"}]\n104:[\"$\",\"meta\",\"29\",{\"name\":\"DC.Rights.rightsHolder\",\"content\":\"The Author(s)\"}]\n105:[\"$\",\"meta\",\"30\",{\"name\":\"citation_title\",\"content\":\"Tweeted Anger Predicts County-Level Results of the 2016 United States Presidential Election\"}]\n106:[\"$\",\"meta\",\"31\",{\"name\":\"citat