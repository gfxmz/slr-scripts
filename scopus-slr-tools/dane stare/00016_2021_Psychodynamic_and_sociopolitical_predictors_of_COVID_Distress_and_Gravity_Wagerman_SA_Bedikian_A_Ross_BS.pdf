<div class="p text-right font-secondary"><a href="table/t0035/" class="usa-link" target="_blank" rel="noopener noreferrer">Open in a new tab</a></div>
<div class="tw-foot p">
<div class="fn" id="tf0035">
<sup>⁎⁎</sup><p class="display-inline" id="np0035">p &lt; 0.01.</p>
