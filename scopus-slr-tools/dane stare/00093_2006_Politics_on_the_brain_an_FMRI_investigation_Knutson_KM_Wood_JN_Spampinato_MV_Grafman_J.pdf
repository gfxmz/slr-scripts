<td align="left" valign="middle" rowspan="1" colspan="1">R inferior frontal gyrus, BA 9, extending into middle frontal gyrus, BA 6</td>
<td align="left" valign="middle" rowspan="1" colspan="1">59</td>
<td align="left" valign="middle" rowspan="1" colspan="1">59</td>
<td align="left" valign="middle" rowspan="1" colspan="1">9</td>
<td align="left" valign="middle" rowspan="1" colspan="1">29</td>
<td align="left" valign="middle" rowspan="1" colspan="1">4.05</td>
