<td align="left" valign="middle" rowspan="1" colspan="1">Negative Correlation with affiliation strength</td>
<td align="left" valign="middle" rowspan="1" colspan="1"></td>
<td align="left" valign="middle" rowspan="1" colspan="1"></td>
<td align="left" valign="middle" rowspan="1" colspan="1"></td>
<td align="left" valign="middle" rowspan="1" colspan="1"></td>
