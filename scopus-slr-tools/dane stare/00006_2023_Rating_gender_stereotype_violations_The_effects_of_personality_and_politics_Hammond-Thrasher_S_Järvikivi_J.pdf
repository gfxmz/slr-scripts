-]--><!--[--><span class="References__givenNames">D.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--></span><!--]--> (<!--[--><!--[-->2017<!--]--><!--]-->). <!--[--><!--[-->Ordinal GAMMs: A new window on human ratings,<!--]--><!--]--> in <!--[--><i class="References__source">Each Venture, A New Beginning: Studies in Honor of Laura A. Janda</i><!--]-->, eds <!--[--><span person-group-type="editor" class="References__personGroup"><!--[--><span class="References__name"><!--[--><span class="References__surname">Makarova</span><!--]--><!--[--><span class="References__givenNames">A.</span><!--]--></span><!--]--><!--[--><span class="References__name"><!--[--><span class="References__surname">Dickey</span><!--]--><!--[--><span class="References__givenNames">S. M.</span><!--]--></span><!--]--><!--[--><span class="References__name"><!--[--><span class="References__surname">Divjak</span><!--]--><!--[--><span class="References__givenNames">D.</span><!--]--></span><!--]--></span><!--]--> (<!--[--><!--[-->Bloomington<!--]--><!--]-->: <!--[--><!--[-->Slavica Publishers<!--]--><!--]-->), <!--[--><!--[-->39<!--]--><!--]-->–<!--[--><!--[-->56<!--]--><!--]-->.<!--]--><!--]--></p><ul class="References__links"><!----><!----><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?author=R.%2BH..%2BBaayen&amp;author=D..%2BDivjak&amp;publication_year=2017&amp;title=Ordinal%2BGAMMs%3A%2BA%2Bnew%2Bwindow%2Bon%2Bhuman%2Bratings%2C&amp;journal=Each+Venture%2C+A+New+Beginning%3A+Studies+in+Honor+of+Laura+A.+Janda&amp;pages=39-56" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B3a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B4"><div class="References__label"><p>4</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Banaji</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">M. R.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Hardin</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">C. D.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--></span><!--]--> (<!--[--><!--[-->1996<!--]--><!--]-->). <!--[--><!--[-->Automatic stereotyping<!--]--><!--]-->. <!--[--><i class="References__source">Psychol. Sci</i><!--]-->. <!--[--><!--[-->7<!--]--><!--]-->, <!--[--><!--[-->136<!--]--><!--]-->–<!--[--><!--[-->141<!--]--><!--]-->. <!--[--><!--[-->10.1111/j.1467-9280.1996.tb00346.x<!--]--><!--]--><!--]--><!--]--></p><ul class="References__links"><!----><li class="References__links__item"><a href="https://doi.org/10.1111/j.1467-9280.1996.tb00346.x" target="_blank" data-event="articleReference-a-crossRef">CrossRef </a></li><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?author=M.%2BR..%2BBanaji&amp;author=C.%2BD..%2BHardin&amp;publication_year=1996&amp;title=Automatic%2Bstereotyping&amp;journal=Psychol.+Sci&amp;volume=7&amp;pages=136-141" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B4a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B5"><div class="References__label"><p>5</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Baron-Cohen</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">S.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Wheelwright</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">S.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--></span><!--]--> (<!--[--><!--[-->2004<!--]--><!--]-->). <!--[--><!--[-->The empathy quotient: an investigation of adults with asperger syndrome or high functioning autism, and normal sex differences<!--]--><!--]-->. <!--[--><i class="References__source">J. Autism Dev. Disord</i><!--]-->. <!--[--><!--[-->34<!--]--><!--]-->, <!--[--><!--[-->163<!--]--><!--]-->–<!--[--><!--[-->175<!--]--><!--]-->. <!--[--><!--[-->10.1023/B:JADD.0000022607.19833.00<!--]--><!--]--><!--[--><!--]--><!--]--><!--]--></p><ul class="References__links"><li class="References__links__item"><a href="https://pubmed.ncbi.nlm.nih.gov/15162935" target="_blank" data-event="articleReference-a-pubmedAbstract">Pubmed Abstract</a></li><li class="References__links__item"><a href="https://doi.org/10.1023/B:JADD.0000022607.19833.00" target="_blank" data-event="articleReference-a-crossRef">CrossRef </a></li><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?author=S..%2BBaron-Cohen&amp;author=S..%2BWheelwright&amp;publication_year=2004&amp;title=The%2Bempathy%2Bquotient%3A%2Ban%2Binvestigation%2Bof%2Badults%2Bwith%2Basperger%2Bsyndrome%2Bor%2Bhigh%2Bfunctioning%2Bautism%2C%2Band%2Bnormal%2Bsex%2Bdifferences&amp;journal=J.+Autism+Dev.+Disord&amp;volume=34&amp;pages=163-175" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B5a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B6"><div class="References__label"><p>6</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Block</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">J.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--></span><!--]--> (<!--[--><!--[-->1995<!--]--><!--]-->). <!--[--><!--[-->A contrarian view of the five-factor approach to personality description<!--]--><!--]-->. <!--[--><i class="References__source">Psychol. Bull.</i><!--]--><!--[--><!--[-->117<!--]--><!--]-->, <!--[--><!--[-->187<!--]--><!--]-->–<!--[--><!--[-->215<!--]--><!--]-->. <!--[--><!--[-->10.1037/0033-2909.117.2.187<!--]--><!--]--><!--[--><!--]--><!--]--><!--]--></p><ul class="References__links"><li class="References__links__item"><a href="https://pubmed.ncbi.nlm.nih.gov/7724687" target="_blank" data-event="articleReference-a-pubmedAbstract">Pubmed Abstract</a></li><li class="References__links__item"><a href="https://doi.org/10.1037/0033-2909.117.2.187" target="_blank" data-event="articleReference-a-crossRef">CrossRef </a></li><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?author=J..%2BBlock&amp;publication_year=1995&amp;title=A%2Bcontrarian%2Bview%2Bof%2Bthe%2Bfive-factor%2Bapproach%2Bto%2Bpersonality%2Bdescription&amp;journal=Psychol.+Bull.&amp;volume=117&amp;page