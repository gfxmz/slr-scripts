/repozytorium.uw.edu.pl/server/api/system/systemwidealerts/search/active":{"data":{"type":{"value":"paginated-list"},"pageInfo":{"elementsPerPage":20,"totalElements":0,"totalPages":0,"currentPage":1},"_links":{"self":{"href":"https://repozytorium.uw.edu.pl/server/api/system/systemwidealerts/search/active"},"page":[]}},"timeCompleted":1790385198133,"msToLive":900000,"requestUUIDs":["client/f3ea843c-881a-4964-a03e-74882fe7531b"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://repozytorium.uw.edu.pl/server/api/config/properties/submit.type-bind.field":{"data":{"type":"property","uuid":"submit.type-bind.field","name":"submit.type-bind.field","values":["dc.type"],"_links":{"self":{"href":"https://repozytorium.uw.edu.pl/server/api/config/properties/submit.type-bind.field"}}},"timeCompleted":1790385198138,"msToLive":900000,"requestUUIDs":["client/44e93451-ee51-4dc6-a4b6-a7ea1ae95b0a"],"dependentRequestUUIDs":[],"isDirty":false,"patches":[],"alternativeLinks":[]},"https://repozytorium.uw.edu.pl/server/api/core/sites/9c4ddd82-351d-11ee-be56-0242ac120002":{"data":{"_name":"The Institutional Repository of the University of Warsaw (ReIn UW)","id":"9c4ddd82-351d-11ee-be56-0242ac120002","uuid":"9c4ddd82-351d-11ee-be56-0242ac120002","type":"site","metadata":{"cris.cms.footer":[{"uuid":"f858a8ba-abec-427a-bebb-8476c688bd93","language":"pl","value":"","place":0,"authority":null,"confidence":-1},{"uuid":"2378ea96-6a2b-47f2-96a3-d4319de22159","language":"en","value":"","place":1,"authority":null,"confidence":-1}],"cris.cms.home-news":[{"uuid":"289b5e91-3f20-4c78-b9f5-1b0f3e32aef8","language":"pl","value":"\u003Cp>\u003Cb>W 2026 roku zapraszamy na cykl szkoleń z zasad Polityki otwartej nauki UW i obsługi Repozytorium Instytucjonalnego.\u003C/b>\u003C/p> \u003Ca href=\"https://www.buw.uw.edu.pl/szkolenia/\">\u003Cb>Zapisy na SZKOLENIA\u003C/b>\u003C/a>\u003C/p>\n\u003Cbr>\n\u003Cb>\u003Ca href=\"https://4euplus.eu/4EU-1245.html\">Open for you! Zapraszany na webinaria Sojuszu 4EU+ poświęcone otwartej nauce\u003C/a>\u003C/b>\u003C/p>\n\u003Cbr>\n\u003Cp>\u003Cb>Repozytorium Instytucjonalne Uniwersytetu Warszawskiego (ReIn UW) \u003C/b> gromadzi, przechowuje i upowszechnia różnorodne publikacje stanowiące dorobek naukowy pracowników, doktorantów i studentów Uniwersytetu Warszawskiego. \n\u003Cp>Jego ambicją jest zapewnienie wszystkim zainteresowanym otwartego dostępu do jak największej liczby publikacji naukowych powstałych na UW. \u003C/p>\n\u003Cbr>\n\u003Cp>ReIn UW jest powiązany z Repozytorium \u003Cb>\u003Ca href=\"https://danebadawcze.uw.edu.pl/\">“Dane Badawcze UW”\u003C/a>\u003C/b>, poprzez linkowanie między sobą rekordów publikacji i danych badawczych, które były podstawą analiz i wniosków.\u003C/p>\n\u003Cbr>\n \u003Cp>Link do instrukcji deponowania dostępny \u003Cb>\u003Ca href=\"https://view.genially.com/67eeb583d1ff454fddd01095/\">tutaj.\u003C/a>\u003C/b>\u003C/p>  \n\u003Cbr>\n\u003Cbr>\n\u003Cp>\u003Cb>\u003Ca href=\"https://repozytorium.uw.edu.pl/search?spc.page=1&spc.sf=dc.date.accessioned&spc.sd=DESC/\">OSTATNIO DODANE - pełna lista nowości w Repozytorium\u003C/a>\u003C/b>\u003C/p> \n\u003Cbr>","place":0,"authority":null,"confidence":-1},{"uuid":"6f59f239-ffa0-4e19-9ccb-5f2878ae5b47","language":"en","value":"\u003Cp>\u003Cb>Sign up for the \u003Ca href=\"https://www.buw.uw.edu.pl/szkolenia/\">TRAINING\u003C/a> session on submitting publications.\u003C/b>\u003C/p>\n\u003Cbr>\n\u003Cp>The Institutional Repository of the University of Warsaw (ReIn UW) collects, preserves, and disseminates scientific publications produced by employees, doctoral students, and students of the University of Warsaw.\n\u003Cp>Its goal is to provide open access to a wide range of scientific publications produced at UW.\u003C/p>\n\u003Cbr>\n\u003Cp>ReIn UW is linked to the\u003Cb>\u003Ca href=\"https://danebadawcze.uw.edu.pl/\"> 'UW Research Data' Repository\u003C/a>\u003C/b> by interlinking publication records and research data that formed the basis for analyses and conclusions.\u003C/p>\n\u003Cbr>\n\u003Cp>Link to deposit instructions (Polish language) available \u003Cb>\u003Ca href=\"https://view.genially.com/67eeb583d1ff454fddd01095/\">here.\u003C/a>\u003C/b>\u003C/p> \n\u003Cbr>\n\u003Cp>\u003Cb>We warmly invite you to the 2026 edition of \u003Ca href=\"https://4euplus.eu/4EU-1245.html\">Open for you!\u003C/a> - a webinar series delving into the various aspects of open science.\u003C/b>\u003C/p>\n\u003Cbr>\n\u003Cbr>\n\u003Cp>\u003Cb>\u003Ca href=\"https://repozytorium.uw.edu.pl/search?spc.page=1&spc.sf=dc.date.accessioned&spc.sd=DESC/\">RECENTLY ADDED - full list of new items in the Repository\u003C/a>\u003C/b>\u003C/p> \n\u003Cbr>","place":1,"authority":null,"confidence":-1}],"dc.rights":[{"uuid":"bea53ddb-e959-4388-8642-bd0897e35b45","language":"pl","value":"Zakładając konto, akceptują Państwo “Regulamin” i “Politykę prywatności“ oraz wyrażają zgodę na przetwarzanie swoich danych osobowych w celu prowadzenia Repozytorium Instytucjonalnego Uniwersytetu Warszawskiego.","place":0,"authority":null,"confidence":-1},{"uuid":"9d93eb44-fac3-4f40-952c-006852a59003","language":"en","value":"By creating an account, you accept the \"Terms and Conditions\" and \"Privacy Policy\" and agree to the processing of your personal data for the purpose of running the University of Warsaw Institutional Repository.","place":1,"authority":null,"confidence":-1}]},"_links":{"self":{"href":"https://repozytorium.uw.edu.pl/server/api/core/sites/9c4ddd82-351d-11ee-be56-0242ac120002"}}},"timeCompleted":1790385198142,"msToLive":900000,"requestUUIDs":["client/0e3021ce-21cc-4877-bbe3-d41cc0c2878a"],"dependentRequestUUIDs":["client/1d0e1223-f1db-4f70-8b5a-2f36df7825b5","client/5c1baa2e-a903-41f8-b980-d13c24b67f39","client/d74575b1-bbec-4f2e-8dac-b606d7deae30","client/d03877e3-1c73-4241-9167-cc820677009a","client/e88307ae-77e1-45f9-9020-3d86a709b1a1","client/9029498d-5f18-4735-8903-72511de3874c","client/558b6f