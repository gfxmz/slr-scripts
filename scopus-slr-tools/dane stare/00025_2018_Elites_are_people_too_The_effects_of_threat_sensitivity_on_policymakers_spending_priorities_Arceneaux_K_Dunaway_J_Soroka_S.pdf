<meta name="citation_author" content="Johanna Dunaway"/>
  <meta name="citation_author_institution" content="Department of Communication, Texas A&M University, College Station, Texas, United States of America"/>
<meta name="citation_author" content="Stuart Soroka"/>
  <meta name="citation_author_institution" content="Department of Communication Studies, University of Michigan, Ann Arbor, Michigan, United States of America"/>

<meta name="citation_title" content="Elites are people, too: The effects of threat sensitivity on policymakers&rsquo; spending priorities"/>
