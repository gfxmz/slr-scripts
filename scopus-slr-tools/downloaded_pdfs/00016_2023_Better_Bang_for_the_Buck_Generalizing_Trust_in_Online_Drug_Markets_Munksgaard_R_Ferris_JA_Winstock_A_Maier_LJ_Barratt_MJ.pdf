            <div id="cite-apa" class="tab selected" role="tabpanel" aria-labelledby="tab-0" tabindex="-1" aria-hidden="true">
                <div class="rendering rendering_researchoutput  rendering_researchoutput_apa rendering_contributiontojournal rendering_apa rendering_contributiontojournal_apa"><a rel="Person" href="https://vbn.aau.dk/da/persons/ramuan/" class="link"><span>Munksgaard, R.</span></a>, Ferris, J. A., Winstock, A., Maier, L. J., &amp; Barratt, M. J. (2023). <a rel="ContributionToJournal" href="https://vbn.aau.dk/da/publications/better-bang-for-the-buck-generalizing-trust-in-online-drug-market-2/" class="link"><span>Better Bang for the Buck? Generalizing Trust in Online Drug Markets</span></a>. <span><em>British Journal of Criminology</em></span>, <em>63</em>(4), 906-928. <a onclick="window.open(this.href, '_blank','noopener,noreferrer'); return false;" href="https://doi.org/10.1093/bjc/azac070" class="link"><span>https://doi.org/10.1093/bjc/azac070</span></a></div>
