<title>
"“Etazene, Safer Than Heroin and Fentanyl”: Non-Fentanyl Novel Syntheti" by Francois R. Lamy, Raminta Daniulaityte et al.
</title>


<!-- FILE article_meta-tags.inc --><!-- FILE: /srv/sequoia/main/data/assets/site/article_meta-tags.inc -->
<meta itemprop="name" content="“Etazene, Safer Than Heroin and Fentanyl”: Non-Fentanyl Novel Synthetic Opioid Listings on One Darknet Market">
<meta property="og:title" content="“Etazene, Safer Than Heroin and Fentanyl”: Non-Fentanyl Novel Synthetic Opioid Listings on One Darknet Market">
<meta name="twitter:title" content="“Etazene, Safer Than Heroin and Fentanyl”: Non-Fentanyl Novel Synthetic Opioid Listings on One Darknet Market">
<meta property="article:author" content="Francois R. Lamy">
<meta name="author" content="Francois R. Lamy">
<meta property="article:author" content="Raminta Daniulaityte">
<meta name="author" content="Raminta Daniulaityte">
