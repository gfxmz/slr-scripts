			<div id="articleFullText">
		<h4 style="font-weight:normal;font-size: 11px !important;">Full Text:</h4>
									<a href="https://sajim.co.za/index.php/sajim/article/view/2139/3668" class="file" target="_parent">
					HTML
										&nbsp				</a>
				|											<a href="https://sajim.co.za/index.php/sajim/article/view/2139/3669" class="file" target="_parent">
					EPUB
										&nbsp				</a>
				|											<a href="https://sajim.co.za/index.php/sajim/article/view/2139/3670" class="file" target="_parent">
					XML
										&nbsp				</a>
				|											<a href="https://sajim.co.za/index.php/sajim/article/view/2139/3671" class="file" target="_parent">
