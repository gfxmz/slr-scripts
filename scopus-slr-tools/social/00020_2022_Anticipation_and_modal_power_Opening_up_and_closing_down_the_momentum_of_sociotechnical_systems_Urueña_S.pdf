<meta name="DC.relation" content="nfo:eu-repo/grantAgreement/MINECO/BES-2016-079192" xml:lang="es_ES" />
<meta name="DC.rights" content="info:eu-repo/semantics/openAccess" xml:lang="es_ES" />
<meta name="DC.subject" content="Anticipation" xml:lang="es_ES" />
<meta name="DC.subject" content="Modal power" xml:lang="es_ES" />
<meta name="DC.subject" content="Sociotechnical futures" xml:lang="es_ES" />
<meta name="DC.subject" content="Technological momentum" xml:lang="es_ES" />
<meta name="DC.subject" content="Sociotechnical imaginaries" xml:lang="es_ES" />
<meta name="DC.subject" content="Future-making politics" xml:lang="es_ES" />
<meta name="DC.title" content="Anticipation and modal power: Opening up and closing down the momentum of sociotechnical systems" xml:lang="es_ES" />
