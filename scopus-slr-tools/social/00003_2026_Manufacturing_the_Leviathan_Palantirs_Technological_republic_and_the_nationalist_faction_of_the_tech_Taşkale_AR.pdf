                <div class="rendering rendering_researchoutput  rendering_researchoutput_bibtex rendering_contributiontojournal rendering_bibtex rendering_contributiontojournal_bibtex"><div>@article{1e9b36249dc447dd9a16da2c271589cf,</div><div>  title     = "Manufacturing the Leviathan: Palantir{\textquoteright}s {\textquoteleft}Technological republic{\textquoteright} and the nationalist faction of the tech oligarchy",</div><div>  abstract  = "Is palantir a {\textquoteleft}superweapon' or a marketing masterclass? This article examines the emergence of a {\textquoteleft}nationalist-militarist' faction within the contemporary tech oligarchy through a critical reading of The Technological Republic (2025) by Palantir CEO Alexander Karp and Nicholas Zamiska. I argue that the book operates as an ideological manifesto designed to re-legitimize Silicon Valley's entanglement with the U.S. national security state, framing this alliance as a patriotic necessity in a Schmittian struggle against China. Rejecting both the company's self-mythologizing and popular portrayals of Palantir as an all-powerful, shadowy monolith, the article draws on STS scholarship and G{\"o}ran Therborn's theory of ruling-class reproduction to analyze the {\textquoteleft}Palantir imaginary.' This imaginary of seamless, illiberal control is not an empirical reality but a carefully branded sociotechnical fantasy, cultivated to align with security agencies' desire for total situational awareness. I show how Palantir positions itself not merely as a software provider but as a strategic political actor engaged in an intra-oligarchic struggle against {\textquoteleft}globalist{\textquoteright} consumer-tech firms, advancing a technocratic, anti-democratic vision of sovereignty that replaces democratic oversight with proprietary algorithmic governance. The article concludes by demonstrating how the fusion of corporate accumulation and state power into a black-boxed sociotechnical system poses a fundamental challenge to democratic accountability.",</div><div>  keywords  = "Tech oligarchy, The Technological Republic, Palantir imaginary, Schmittian geopolitics, Algorithmic governance, Anti-democratic turn, Tech oligarchy, The Technological Republic, Palantir imaginary, Schmittian geopolitics, Algorithmic governance, Anti-democratic turn",</div><div>  author    = "Taskale, \{Ali Riza\}",</div><div>  year      = "2026",</div><div>  doi       = "10.1080/09505431.2025.2607360",</div><div>  language  = "English",</div><div>  volume    = "Latest articles",</div><div>  journal   = "Science as Culture",</div><div>  issn      = "0950-5431",</div><div>  publisher = "Routledge",</div><p>}</p></div>
