    <div id="articleTitle">
      <h1>Theoretical and Methodological Foundations of the Concept of Digital Transformation in Criminal Proceedings
          </h1>
      
    </div>

      <div id="authorString"><em>
          <a title="V. I. Przhilenskiy" href="http://orcid.org/0000-0002-5942-3732" target="_blank"><img src="/resources/orcid.png"></a>&nbsp;<a rel="nofollow" href='/index.php/jour/search?authors=V. AND I. AND Przhilenskiy'>
        V. I. Przhilenskiy</a>        </em></div>
    

                        
              <p><a id="pub-id::doi" href="https://doi.org/10.17803/2713-0533.2026.1.35.001-022"  aria-label="DOI for Theoretical and Methodological Foundations of the Concept of Digital Transformation in Criminal Proceedings"  >https://doi.org/10.17803/2713-0533.2026.1.35.001-022</a></p>        

          <div class="banner">
    
  </div>
