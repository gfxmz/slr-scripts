e, human, Kosovo, police, politics, social change",</div><div>  author    = "Currie, \{Morgan E.\} and Paris, \{Britt S.\} and Donovan, \{Joan M.\}",</div><div>  year      = "2019",</div><div>  month     = oct,</div><div>  day       = "14",</div><div>  doi       = "10.1108/OIR-02-2018-0052",</div><div>  language  = "English",</div><div>  volume    = "43",</div><div>  pages     = "971--985",</div><div>  journal   = "Online Information Review",</div><div>  issn      = "1468-4527",</div><div>  publisher = "Emerald Group Publishing",</div><div>  number    = "6",</div><p>}</p></div>
