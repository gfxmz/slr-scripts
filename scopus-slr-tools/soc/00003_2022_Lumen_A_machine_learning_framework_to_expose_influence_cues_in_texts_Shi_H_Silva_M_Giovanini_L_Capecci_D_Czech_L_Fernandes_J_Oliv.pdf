pe Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B6"><div class="References__label"><p>6</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__collab">(2019g)</span><!--]--><!--[--><!--]--></span><!--]-->. <!--[--><i class="References__source">Phishing Alerts, UA Security</i><!--]-->. <!--[--><!--[-->University of Arizona<!--]--><!--]-->.<!--]--><!--]--></p><ul class="References__links"><!----><!----><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?journal=Phishing+Alerts%2C+UA+Security" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B6a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B7"><div class="References__label"><p>7</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__collab">(2019h)</span><!--]--><!--[--><!--]--></span><!--]-->. <!--[--><i class="References__source">Phishes and Scams</i><!--]-->. <!--[--><!--[-->University of Michigan<!--]--><!--]-->.<!--]--><!--]--></p><ul class="References__links"><!----><!----><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?journal=Phishes+and+Scams" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B7a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B8"><div class="References__label"><p>8</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__collab">(2021)</span><!--]--><!--[--><!--]--></span><!--]-->. <!--[--><i class="References__source">Fact Check: Courts Have Dismissed Multiple Lawsuits of Alleged Electoral Fraud Presented by Trump Campaign</i><!--]-->. <!--[--><!--[-->Reuters Staff<!--]--><!--]-->.<!--]--><!--]--></p><ul class="References__links"><!----><!----><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?journal=Fact+Check%3A+Courts+Have+Dismissed+Multiple+Lawsuits+of+Alleged+Electoral+Fraud+Presented+by+Trump+Campaign" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B8a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B9"><div class="References__label"><p>9</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Akbar</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">N.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--></span><!--]--> (<!--[--><!--[-->2014<!--]--><!--]-->). <!--[--><i class="References__source">Analysing Persuasion Principles in Phishing Emails</i><!--]-->. <!--[--><!--[-->University of Twente<!--]--><!--]-->.<!--]--><!--]--></p><ul class="References__links"><!----><!----><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?author=N..%2BAkbar&amp;publication_year=2014&amp;journal=Analysing+Persuasion+Principles+in+Phishing+Emails" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B9a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B10"><div class="References__label"><p>10</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Akhawe</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">D.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Felt</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">A. P.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--></span><!--]--> (<!--[--><!--[-->2013<!--]--><!--]-->). <!--[--><!--[-->“Alice in warningland: a large-scale field study of browser security warning effectiveness,”<!--]--><!--]--> in <!--[--><i class="References__source">22nd USENIX Security Symposium</i><!--]-->, 257–272.<!--]--><!