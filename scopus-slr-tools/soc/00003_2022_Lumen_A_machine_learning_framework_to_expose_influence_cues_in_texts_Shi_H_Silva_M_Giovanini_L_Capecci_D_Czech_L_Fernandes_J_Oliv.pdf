<!--[--><!--]--></span><!--]--><!--[--><!--]--></span><!--]--> (<!--[--><!--[-->2009<!--]--><!--]-->). <!--[--><!--[-->Large stakes and big mistakes<!--]--><!--]-->. <!--[--><i class="References__source">Rev. Econ. Stud</i><!--]-->. <!--[--><!--[-->76<!--]--><!--]-->, <!--[--><!--[-->451<!--]--><!--]-->–<!--[--><!--[-->469<!--]--><!--]-->. <!--[--><!--[-->10.1111/j.1467-937X.2009.00534.x<!--]--><!--]--><!--]--><!--]--></p><ul class="References__links"><!----><li class="References__links__item"><a href="https://doi.org/10.1111/j.1467-937X.2009.00534.x" target="_blank" data-event="articleReference-a-crossRef">CrossRef </a></li><li class="References__links__item"><a href="http://scholar.google.com/scholar_lookup?author=D..%2BAriely&amp;author=U..%2BGneezy&amp;author=G..%2BLoewenstein&amp;author=N..%2BMazar&amp;publication_year=2009&amp;title=Large%2Bstakes%2Band%2Bbig%2Bmistakes&amp;journal=Rev.+Econ.+Stud&amp;volume=76&amp;pages=451-469" target="_blank" data-event="articleReference-a-googleScholar">Google Scholar</a></li><li class="References__links__item References__links__item--viewInArticle"><a href="#B11a" class="Link Link--linkType Link--blue50 Link--medium Link--icon Link--arrowUpRight" data-event="articleReference-a-viewInArticle"><span class="References__viewInArticleLabel">View reference in article</span></a></li></ul></div></li><li class="References__item" id="B12"><div class="References__label"><p>12</p></div><div class="References__content"><p class="notranslate"><!--[--><!--[--><!--[--><!--]--><!--[--><span person-group-type="author" class="References__personGroup"><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Bago</span><!--]--><!--[--><!--]--><!--[--><span class="References__givenNames">B.</span><!--]--><!--[--><!--]--></span><!--]--><!--[--><!--]--><!--[--><span class="References__name"><!--[--><!--]--><!--[--><span class="References__surname">Rand</span><!--]--><!--[--><!--]--><!--[-->