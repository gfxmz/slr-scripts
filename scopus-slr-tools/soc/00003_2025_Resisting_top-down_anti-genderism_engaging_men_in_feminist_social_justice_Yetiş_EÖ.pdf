                        <h1 class="c-article-title" data-test="article-title" data-article-title="">Resisting top-down anti-genderism: engaging men in feminist social justice</h1>
                        <ul class="c-article-author-list c-article-author-list--short" data-test="authors-list" data-component-authors-activator="authors-list"><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="1_1" data-track-context="researcher popup with no profile" href="#auth-Erman__rsan-Yeti_-Aff1" data-author-popup="auth-Erman__rsan-Yeti_-Aff1" data-track-label="Erman Örsan Yetiş" data-author-search="Yetiş, Erman Örsan" data-corresp-id="c1">Erman Örsan Yetiş<svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-mail-medium"></use></svg></a><sup class="u-js-hide"><a href="#Aff1">1</a></sup> </li></ul>

                        

