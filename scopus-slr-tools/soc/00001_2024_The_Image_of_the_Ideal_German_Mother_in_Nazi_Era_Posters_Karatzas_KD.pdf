.__next_f.push([1,"28:[\"$\",\"div\",null,{\"className\":\"order-3 col-span-2 grid-cols-subgrid grid gap-10 md:col-span-1 md:order-2 lg:col-span-1 lg:grid-cols-1 xl:col-span-2 xl:grid-cols-2 xl:gap-22\",\"children\":[[\"$\",\"section\",null,{\"role\":\"group\",\"aria-label\":\"Navigation links\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex-1 flex flex-col justify-start items-left gap-3 text-white text-nowrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-subtitle-l\",\"children\":\"Paradigm\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col justify-start items-left gap-2 text-[15px] font-normal\",\"children\":[[\"$\",\"$L21\",\"contact\",{\"prefetch\":false,\"href\":\"/contact\",\"className\":\"hover:text-jade transition-colors duration-200\",\"children\":\"Contact\"}],[\"$\",\"$L21\",\"faq\",{\"prefetch\":false,\"href\":\"/faq\",\"className\":\"hover:text-jade transition-colors duration-200\",\"children\":\"FAQ\"}],[\"$\",\"$L21\",\"about\",{\"prefetch\":false,\"href\":\"/about\",\"className\":\"hover:text-jade transition-colors duration-200\",\"children\":\"About us\"}]]}]]}]}],[\"$\",\"section\",null,{\"role\":\"group\",\"aria-label\":\"Account links\",\"children\":[\"$\",\"$L2b\",null,{}]}]]}]\n"])</script><script>self.__next_f.push([1,"29:[\"$\",\"$L2c\",null,{\"variant\":\"footer\",\"className\":\"order-2 col-span-2 md:order-3 lg:col-span-1\"}]\n"])</script><script>self.__next_f.push([1,"2a:[\"$\",\"div\",null,{\"className\":\"w-full flex justify-stretch items-center bg-deep-blue text-white\",\"role\":\"region\",\"children\":[\"$\",\"div\",null,{\"className\":\"m-auto w-full items-stretch justify-center data-[fluid=true]:max-w-full data-[fluid=false]:max-w-[1280px] px-5 py-6 flex flex-col gap-4 lg:flex-row lg:justify-between lg:items-center\",\"data-fluid\":false,\"children\":[[\"$\",\"div\",null,{\"className\":\"text-label-l font-normal order-2 lg:order-1\",\"children\":\"Copyright 2026 © Paradigm. All rights reserved.\"}],[\"$\",\"div\",null,{\"className\":\"order-3 lg:order-2\",\"children\":[\"$\",\"$L2d\",null,{}]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 lg:gap-5 order-1 lg:order-3 flex-wrap lg:flex-nowrap\",\"children\":[[\"$\",\"$L21\",\"terms\",{\"href\":\"/terms-of-service\",\"prefetch\":false,\"className\":\"text-label-l font-normal hover:text-jade transition-colors duration-200\",\"children\":\"Terms of service\"}],[\"$\",\"$L21\",\"privacy\",{\"href\":\"/privacy-policy\",\"prefetch\":false,\"className\":\"text-label-l font-normal hover:text-jade transition-colors duration-200\",\"children\":\"Privacy policy\"}],[\"$\",\"$L21\",\"publishing\",{\"href\":\"/publishing-ethics\",\"prefetch\":false,\"className\":\"text-label-l font-normal hover:text-jade transition-colors duration-200\",\"children\":\"Ethical policies\"}],[\"$\",\"$L21\",\"accessibility\",{\"href\":\"/accessibility\",\"prefetch\":false,\"className\":\"text-label-l font-normal hover:text-jade transition-colors duration-200\",\"children\":\"Accessibility\"}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"40:I[80622,[],\"IconMark\"]\n2e:T511,"])</script><script>self.__next_f.push([1,"This paper examines the role of women in Nazi Germany and ways the policy and propaganda implemented and enacted both plans an policies to transform women into the mothers of the nation. The paper will focus on the ways propaganda posters were used in order to engage public opinion, using the power of visual arts into manipulating public opinion that the body of a woman should be devoted to the Reich, (re-)producing the pure-blooded German and support the creation of a new empire. The posters supported and acted as a direct reminder of the policies set by Nazi regime, and their ideology on family planning, racial purity and gender roles. The propaganda machine that produced them borrowed symbols from religious works of the Renaissance connecting the “ideal mother” to images of Holy Mary, in a twisted connection between religion and social engineering. The presentation will discuss about the ways Nazi Germany elaborated the role of women, the (ab)use of their body and the ideal depiction of it according to the regime, the distortion of iconic renaissance paintings along with the ways that religion and public policy have been weaved in order to manipulate and re-educate an entire nation will be parts of the presentation in order to highlight this interesting part of history."])</script><script>self.__next_f.push([1,"2f:T518,"])</script><script>self.__next_f.push([1,"\u003cp\u003eThis paper examines the role of women in Nazi Germany and ways the policy and propaganda implemented and enacted both plans an policies to transform women into the mothers of the nation. The paper will focus on the ways propaganda posters were used in order to engage public opinion, using the power of visual arts into manipulating public opinion that the body of a woman should be devoted to the Reich, (re-)producing the pure-blooded German and support the creation of a new empire. The posters supported and acted as a direct reminder of the policies set by Nazi regime, and their ideology on family planning, racial purity and gender roles. The propaganda machine that produced them borrowed symbols from religious works of the Renaissance connecting the “ideal mother” to images of Holy Mary, in a twisted connection between religion and social engineering. The presentation will discuss about the ways Nazi Germany elaborated the role of women, the (ab)use of their body and the ideal depiction of it according to the regime, the distortion of iconic renaissance paintings along with the ways that religion and public policy have been weaved in order to manipulate and re-educate an entire nation will be parts of the presentation in order to highlight this interesting part of history.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"5:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTM