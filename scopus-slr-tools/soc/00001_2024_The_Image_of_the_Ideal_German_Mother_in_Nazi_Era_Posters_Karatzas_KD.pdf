":\"77\"}]\n38:[\"$\",\"meta\",null,{\"name\":\"citation_lastpage\",\"content\":\"91\"}]\n39:[\"$\",\"meta\",null,{\"name\":\"citation_public_url\",\"content\":\"https://reference-global.com/article/10.2478/perc-2024-0012\"}]\n3a:[\"$\",\"meta\",null,{\"name\":\"citation_abstract_html_url\",\"content\":\"https://reference-global.com/article/10.2478/perc-2024-0012?tab=abstract\"}]\n3b:[\"$\",\"meta\",null,{\"name\":\"citation_pdf_url\",\"content\":\"https://reference-global.com/download/article/10.2478/perc-2024-0012.pdf\"}]\n3c:[\"$\",\"meta\",null,{\"name\":\"citation_fulltext_world_readable\",\"content\":\"\"}]\n3d:[\"$\",\"$1\",\"author-0\",{\"children\":[[\"$\",\"meta\",null,{\"name\":\"citation_author\",\"content\":\"Konstantinos D. Karatzas\"}],[[\"$\",\"meta\",\"institution-0\",{\"name\":\"citation_author_institution\",\"content\":\"Global Institute for Research, Education and Scholarship\"}]],\"$undefined\",\"\"]}]\n42:T552,"])</script><script>self.__next_f.push([1,"\u003cabstract xmlns=\"http://www.w3.org/1999/xhtml\"\u003e\u003cp\u003eThis paper examines the role of women in Nazi Germany and ways the policy and propaganda implemented and enacted both plans an policies to transform women into the mothers of the nation. The paper will focus on the ways propaganda posters were used in order to engage public opinion, using the power of visual arts into manipulating public opinion that the body of a woman should be devoted to the Reich, (re-)producing the pure-blooded German and support the creation of a new empire. The posters supported and acted as a direct reminder of the policies set by Nazi regime, and their ideology on family planning, racial purity and gender roles. The propaganda machine that produced them borrowed symbols from religious works of the Renaissance connecting the “ideal mother” to images of Holy Mary, in a twisted connection between religion and social engineering. The presentation will discuss about the ways Nazi Germany elaborated the role of women, the (ab)use of their body and the ideal depiction of it according to the regime, the distortion of iconic renaissance paintings along with the ways that religion and public policy have been weaved in order to manipulate and re-educate an entire nation will be parts of the presentation in order to highlight this interesting part of history.\u003c/p\u003e\u003c/abstract\u003e"])</script><script>self.__next_f.push([1,"3e:[\"$\",\"$L41\",null,{\"product\":{\"_id\":\"69f0355985ac0f3acaae519d\",\"__v\":0,\"articleData\":{\"doi\":\"10.2478/perc-2024-0012\",\"journalKey\":\"PERC\",\"volumeNumber\":\"22\",\"issueNumber\":\"s1\",\"title\":{\"en\":\"The Image of the Ideal German Mother in Nazi Era Posters\"},\"isAccessible\":true,\"licenseType\":\"OpenAccess\",\"licenseText\":{\"en\":\"This work is licensed under the Creative Commons Attribution-NonCommercial-NoDerivatives 3.0 License.\"},\"copyright\":{\"en\":\"© 2024 Konstantinos D. Karatzas, published by Sciendo\"},\"ePubDate\":\"2024-05-30T00:00:00.000Z\",\"pPubDate\":\"2024-05-01T00:00:00.000Z\",\"receivedDate\":null,\"acceptedDate\":null,\"fPage\":\"77\",\"lPage\":\"91\",\"articleCategory\":null,\"prevArticle\":\"10.2478/perc-2024-0011\",\"nextArticle\":null,\"pdfUrl\":\"https://reference-global.com/download/article/10.2478/perc-2024-0012.pdf\",\"keywords\":[\"\u003ckwd\u003epropaganda\u003c/kwd\u003e\",\"\u003ckwd\u003eart\u003c/kwd\u003e\",\"\u003ckwd\u003efemale body\u003c/kwd\u003e\",\"\u003ckwd\u003eRenaissance\u003c/kwd\u003e\",\"\u003ckwd\u003enazi Germany\u003c/kwd\u003e\"],\"classifications\":[],\"abstractContent\":{\"en\":\"$42\"},\"articleContent\":{\"en\":\"\"},\"figuresAndTables\":\"\",\"referenceList\":[],\"supplement\":[],\"relatedArticles\":[],\"funding\":[],\"highlights\":[]},\"contentType\":\"academic\",\"contributors\":[{\"name\":\"Karatzas, Konstantinos D.\",\"role\":\"author\",\"institutions\":[{\"name\":\"Global Institute for Research, Education and Scholarship\",\"city\":\"Amsterdam\"}