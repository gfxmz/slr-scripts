<!--Google Scholar Indexing-->
function add_google_scholar_metadata() {
if ( is_single() ) { // Ensures tags only output on individual article posts
global $post;
$title = get_post_meta($post->ID, 'academic_title', true);
$author = get_post_meta($post->ID, 'academic_author', true);
$volume = get_post_meta($post->ID, 'academic_volume', true);
$issue = get_post_meta($post->ID, 'academic_issue', true);
$firstpage = get_post_meta($post->ID, 'academic_firstpage', true);
$lastpage = get_post_meta($post->ID, 'academic_lastpage', true);
$journal_title = get_post_meta($post->ID, 'academic_journal_title', true);
$keywords = get_post_meta($post->ID, 'academic_keywords', true);
$pdf_url = get_post_meta($post->ID, 'academic_pdf_url', true);
$doi = get_post_meta($post->ID, 'academic_doi', true);
$url = get_post_meta($post->ID, 'academic_url', true);
$publication_date = get_post_meta($post->ID, 'academic_publication_date', true);
$publisher = get_post_meta($post->ID, 'academic_publisher', true);
if ( !empty($title) ) {
echo '<meta name="citation_title" content="' . esc_attr($title) . '" />' . "\n";
}
if ( !empty($author) ) {
// If authors are comma-separated, split them into individual tags
$authors = explode(',', $author);
foreach ($authors as $auth) {
echo '<meta name="citation_author" content="' . esc_attr(trim($auth)) . '" />' . "\n";
}
}
if ( !empty($volume) ) {
echo '<meta name="citation_volume" content="' . esc_attr($volume) . '" />' . "\n";
}
if ( !empty($issue) ) {
echo '<meta name="citation_issue" content="' . esc_attr($issue) . '" />' . "\n";
}
if ( !empty($firstpage) ) {
echo '<meta name="citation_firstpage" content="' . esc_attr($firstpage) . '" />' . "\n";
}
if ( !empty($lastpage) ) {
echo '<meta name="citation_lastpage" content="' . esc_attr($lastpage) . '" />' . "\n";
}
if ( !empty($journal_title) ) {
echo '<meta name="citation_journal_title" content="' . esc_attr($journal_title) . '" />' . "\n";
}
if ( !empty($keywords) ) {
echo '<meta name="citation_keywords" content="' . esc_attr($keywords) . '" />' . "\n";
}
if ( !empty($pdf_url) ) {
echo '<meta name="citation_pdf_url" content="' . esc_url($pdf_url) . '" />' . "\n";
}
if ( !empty($doi) ) {
echo '<meta name="citation_doi" content="' . esc_attr($doi) . '" />' . "\n";
}
if ( !empty($url) ) {
echo '<meta name="citation_url" content="' . esc_attr($url) . '" />' . "\n";
}
if ( !empty($publication_date) ) {
echo '<meta name="citation_publication_date" content="' . esc_attr($publication_date) . '" />' . "\n";
}
if ( !empty($publisher) ) {
echo '<meta name="citation_publisher" content="' . esc_attr($publisher) . '" />' . "\n";
}
}
}
add_action('wp_head', 'add_google_scholar_metadata');
</style>
